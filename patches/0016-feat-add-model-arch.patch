+void llm_arch_model_minicpm3::create_tensors(llama_model & model, const create_tensor_fn & create) {
+    const auto & hp = model.hparams;
+
+    const int64_t n_embd        = hp.n_embd;
+    const int64_t n_head        = hp.n_head();
+    const int64_t n_embd_gqa    = hp.n_embd_v_gqa();
+    const int64_t n_embd_head_k = hp.n_embd_head_k;
+    const int64_t n_embd_head_v = hp.n_embd_head_v;
+    const int64_t n_embd_head_qk_rope = hp.n_rot;
+    const int64_t n_embd_head_qk_nope = hp.n_embd_head_k - hp.n_rot;
+
+    const int64_t q_lora_rank  = hp.n_lora_q;
+    const int64_t kv_lora_rank = hp.n_lora_kv;
+    const int64_t n_ff          = hp.n_ff();
+    const int64_t n_vocab       = model.vocab.n_tokens();
+    const int     n_layer       = hp.n_layer;
+
+    const int TENSOR_NOT_REQUIRED = llama_model_loader::TENSOR_NOT_REQUIRED;
+    const int TENSOR_DUPLICATED   = llama_model_loader::TENSOR_DUPLICATED;
+
+    const auto tn = LLM_TN(model.arch);
+
+    model.tok_embd    = create(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"),   {n_embd, n_vocab}, 0);
+    model.output_norm = create(tn(LLM_TENSOR_OUTPUT_NORM, "weight"),   {n_embd},          0);
+    model.output      = create(tn(LLM_TENSOR_OUTPUT,      "weight"),   {n_embd, n_vocab}, TENSOR_NOT_REQUIRED);
+    if (model.output == nullptr) {
+        model.output  = create(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"),   {n_embd, n_vocab}, TENSOR_DUPLICATED);
+    }
+
+    for (int i = 0; i < n_layer; ++i) {
+        auto & layer = model.layers[i];
+
+        layer.attn_norm = create(tn(LLM_TENSOR_ATTN_NORM, "weight", i), {n_embd}, 0);
+        layer.attn_q_a_norm = create(tn(LLM_TENSOR_ATTN_Q_A_NORM, "weight", i), {q_lora_rank}, 0);
+
+        layer.attn_kv_a_norm = create(tn(LLM_TENSOR_ATTN_KV_A_NORM, "weight", i), {kv_lora_rank}, 0);
+
+        layer.wq_a = create(tn(LLM_TENSOR_ATTN_Q_A, "weight", i), {n_embd, q_lora_rank}, 0);
+        layer.wq_b = create(tn(LLM_TENSOR_ATTN_Q_B, "weight", i), {q_lora_rank, n_head * n_embd_head_k}, 0);
+
+        layer.wkv_a_mqa = create(tn(LLM_TENSOR_ATTN_KV_A_MQA, "weight", i), {n_embd, kv_lora_rank + (n_embd_head_qk_rope)}, 0);
+        layer.wkv_b     = create(tn(LLM_TENSOR_ATTN_KV_B,     "weight", i), {kv_lora_rank, n_head * (n_embd_head_qk_nope + n_embd_head_v)}, 0);
+        layer.wo        = create(tn(LLM_TENSOR_ATTN_OUT,      "weight", i), {              n_head * (                      n_embd_head_v), n_embd}, 0);
+
+        layer.ffn_norm = create(tn(LLM_TENSOR_FFN_NORM, "weight", i), {n_embd}, 0);
+
+        layer.ffn_gate = create(tn(LLM_TENSOR_FFN_GATE, "weight", i), {n_embd,   n_ff}, 0);
+        layer.ffn_down = create(tn(LLM_TENSOR_FFN_DOWN, "weight", i), {  n_ff, n_embd}, 0);
+        layer.ffn_up   = create(tn(LLM_TENSOR_FFN_UP,   "weight", i), {n_embd,   n_ff}, 0);
+
+        layer.rope_long  = create(tn(LLM_TENSOR_ROPE_FACTORS_LONG,  "weight", i), { n_embd_head_qk_rope/2 }, TENSOR_NOT_REQUIRED | (i != 0 ? TENSOR_DUPLICATED : 0));
+        layer.rope_short = create(tn(LLM_TENSOR_ROPE_FACTORS_SHORT, "weight", i), { n_embd_head_qk_rope/2 }, TENSOR_NOT_REQUIRED | (i != 0 ? TENSOR_DUPLICATED : 0));
+    }
+}
