+// Gemma3模型实现
+static const struct gemma3_size_entry {
+    uint32_t n_layer;
+    int64_t  n_embd;
+    int32_t  n_head;
+    llm_type type;
+} GEMMA3_SIZE_TABLE[] = {
+    {26, 2560, 8, LLM_TYPE_1B},
+    {34, 3584, 16, LLM_TYPE_4B},
+    {48, 4608, 32, LLM_TYPE_12B},
