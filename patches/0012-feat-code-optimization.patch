-    const char * op_name_filter = nullptr;
-    const char * backend_filter = nullptr;
-    const char * params_filter = nullptr;
-
-    for (int i = 1; i < argc; i++) {
-        if (strcmp(argv[i], "test") == 0) {
-            mode = MODE_TEST;
