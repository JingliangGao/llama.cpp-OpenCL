-            mode = MODE_PERF;
-        } else if (strcmp(argv[i], "grad") == 0) {
-            mode = MODE_GRAD;
-        } else if (strcmp(argv[i], "-o") == 0) {
-            if (i + 1 < argc) {
-                op_name_filter = argv[++i];
