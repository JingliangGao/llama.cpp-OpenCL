-        // 替换旧的张量和缓冲区
-        k_l = std::move(new_k_l);
-        v_l = std::move(new_v_l);
-        ctxs = std::move(new_ctxs);
-        ctx_l = std::move(new_ctx_l);
-        bufs = std::move(new_bufs);
-        // 更新大小
-        size = new_size;
-
-        return true;
-
-    } catch (const std::exception & e) {
