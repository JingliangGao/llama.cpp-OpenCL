+llm_graph_result_ptr llm_arch_model_minicpm3::build_graph(const llama_model & model,
+                                                            const llm_graph_params & params,
+                                                            ggml_cgraph * gf,
+                                                            llm_graph_type /*type*/) const {
+    auto llm = std::make_unique<llm_build_minicpm3>(model, params, gf);
     llm->build_pooling(gf, model.cls, model.cls_b, model.cls_out, model.cls_out_b);
     return std::move(llm->res);
 }
+
+// LLaMA原始模型实现（使用合并的QKV权重）
+static const struct llama_size_entry {
+    uint32_t n_layer;
+    int64_t  n_embd;
+    int32_t  n_head;
+    llm_type type;
+} LLAMA_SIZE_TABLE[] = {
+    {32, 4096, 32, LLM_TYPE_7B},
+    {40, 5120, 40, LLM_TYPE_13B},
+    {60, 6656, 52, LLM_TYPE_30B},
+    {80, 8192, 64, LLM_TYPE_65B},
+};
+
+void llm_arch_model_llama::init_hparams(llama_model & model, llama_model_loader & ml) {
+    ml.get_key(LLM_KV_ATTENTION_LAYERNORM_RMS_EPS, model.hparams.f_norm_rms_eps);
+
+    const auto & hp = model.hparams;
+    model.type = LLM_TYPE_UNKNOWN;
+    for (const auto & e : LLAMA_SIZE_TABLE) {
+        if (hp.n_layer == e.n_layer &&
+            (e.n_embd == 0 || hp.n_embd       == e.n_embd) &&
+            (e.n_head == 0 || hp.n_head()      == (uint32_t)e.n_head)) {
+            model.type = e.type;
+            break;
+        }
+    }
+}
+
+void llm_arch_model_llama::create_tensors(llama_model & model, const create_tensor_fn & create) {
+    const auto & hp = model.hparams;
+
+    const int64_t n_head        = hp.n_head();
+    const int64_t n_embd        = hp.n_embd;
+    const int64_t n_embd_gqa    = hp.n_embd_v_gqa();
+    const int64_t n_embd_k_gqa  = hp.n_embd_k_gqa();
+    const int64_t n_embd_v_gqa  = hp.n_embd_v_gqa();
+    const int64_t n_embd_head_k = hp.n_embd_head_k;
+    const int64_t n_ff          = hp.n_ff();
+    const int64_t n_rot          = hp.n_rot;
+    const int64_t n_vocab       = model.vocab.n_tokens();
+    const int     n_layer       = hp.n_layer;
+
+    const int TENSOR_NOT_REQUIRED = llama_model_loader::TENSOR_NOT_REQUIRED;
+    const int TENSOR_DUPLICATED   = llama_model_loader::TENSOR_DUPLICATED;
+
+    const auto tn = LLM_TN(model.arch);
+
+    model.tok_embd    = create(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"),   {n_embd, n_vocab}, 0);
+    model.output_norm = create(tn(LLM_TENSOR_OUTPUT_NORM, "weight"),   {n_embd},          0);
+    model.output      = create(tn(LLM_TENSOR_OUTPUT,      "weight"),   {n_embd, n_vocab}, TENSOR_NOT_REQUIRED);
+    if (model.output == nullptr) {
+        model.output  = create(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"),   {n_embd, n_vocab}, TENSOR_DUPLICATED);
+    }
+
+    for (int i = 0; i < n_layer; ++i) {
+        auto & layer = model.layers[i];
+
+        layer.attn_norm = create(tn(LLM_TENSOR_ATTN_NORM, "weight", i), {n_embd}, 0);
+
+        layer.wq = create(tn(LLM_TENSOR_ATTN_Q,   "weight", i), {n_embd, n_embd_head_k * n_head}, 0);
+        layer.wk = create(tn(LLM_TENSOR_ATTN_K,   "weight", i), {n_embd, n_embd_k_gqa}, 0);
+        layer.wv = create(tn(LLM_TENSOR_ATTN_V,   "weight", i), {n_embd, n_embd_v_gqa}, 0);
+        layer.wo = create(tn(LLM_TENSOR_ATTN_OUT, "weight", i), {n_embd_head_k * n_head, n_embd}, 0);
+
+        layer.bq = create(tn(LLM_TENSOR_ATTN_Q,   "bias",   i), {n_embd}, TENSOR_NOT_REQUIRED);
+        layer.bk = create(tn(LLM_TENSOR_ATTN_K,   "bias",   i), {n_embd_k_gqa}, TENSOR_NOT_REQUIRED);
+        layer.bv = create(tn(LLM_TENSOR_ATTN_V,   "bias",   i), {n_embd_v_gqa}, TENSOR_NOT_REQUIRED);
+        layer.bo = create(tn(LLM_TENSOR_ATTN_OUT, "bias",   i), {n_embd}, TENSOR_NOT_REQUIRED);
+
+        if (hp.rope_scaling_type_train == LLAMA_ROPE_SCALING_TYPE_LONGROPE) {
+            layer.rope_long  = create(tn(LLM_TENSOR_ROPE_FACTORS_LONG,  "weight", i), {n_rot/2}, TENSOR_NOT_REQUIRED | (i != 0 ? TENSOR_DUPLICATED : 0));
+            layer.rope_short = create(tn(LLM_TENSOR_ROPE_FACTORS_SHORT, "weight", i), {n_rot/2}, TENSOR_NOT_REQUIRED | (i != 0 ? TENSOR_DUPLICATED : 0));
+        }
+        else {
+            layer.rope_freqs = create(tn(LLM_TENSOR_ROPE_FREQS, "weight", i), {n_rot/2}, TENSOR_NOT_REQUIRED | (i != 0 ? TENSOR_DUPLICATED : 0));
+        }
+
+        layer.ffn_norm  = create(tn(LLM_TENSOR_FFN_NORM,  "weight", i), {n_embd}, 0);
+
+        layer.ffn_gate  = create(tn(LLM_TENSOR_FFN_GATE,  "weight", i), {n_embd, n_ff}, 0);
+        layer.ffn_down  = create(tn(LLM_TENSOR_FFN_DOWN,  "weight", i), {n_ff,   n_embd}, 0);
+        layer.ffn_up    = create(tn(LLM_TENSOR_FFN_UP,    "weight", i), {n_embd, n_ff}, 0);
+
+        layer.ffn_gate_b = create(tn(LLM_TENSOR_FFN_GATE, "bias", i), {n_ff}, TENSOR_NOT_REQUIRED);
+        layer.ffn_down_b = create(tn(LLM_TENSOR_FFN_DOWN, "bias", i), {n_embd}, TENSOR_NOT_REQUIRED);
+        layer.ffn_up_b   = create(tn(LLM_TENSOR_FFN_UP,   "bias", i), {n_ff}, TENSOR_NOT_REQUIRED);
+    }
+}
+
+llama_rope_type llm_arch_model_llama::rope_type() const {
+    return LLAMA_ROPE_TYPE_NEOX;
+}
