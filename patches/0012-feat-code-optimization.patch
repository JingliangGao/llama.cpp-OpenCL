-        this.elInUser.value = "";
-        chat.show(this.elDivChat);
-        this.elInUser.focus();
-        this.curChatId = chatId;
-        console.log(`INFO:SimpleChat:MCUI:HandleSessionSwitch:${chatId} entered...`);
-    }
