-
-            new_bufs.emplace_back(buf);
-        }
-
-        // 复制数据到新缓冲区
-        for (int i = 0; i < n_layer; i++) {
-            const uint32_t n_embd_k_gqa = hparams.n_embd_k_gqa(i) + hparams.n_embd_k_s();
