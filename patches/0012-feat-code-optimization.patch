-            return false;
-        }
-        ++pos;
-    }
-
-    for (const auto & stack : stacks_cur) {
-        if (stack.empty()) {
-            return true;
-        }
-    }
-
-    error_pos = pos;
-    error_msg = "Unexpected end of input";
-    return false;
-}
