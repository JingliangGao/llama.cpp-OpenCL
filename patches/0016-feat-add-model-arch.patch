+// ggml_compute_forward_repeat
+
+static void ggml_compute_forward_repeat(
+        const struct ggml_compute_params * params,
+        struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * src0 = dst->src[0];
+
+    GGML_ASSERT(ggml_can_repeat(src0, dst));
+    GGML_ASSERT(src0->type == dst->type);
+
+    GGML_TENSOR_UNARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const size_t type_size = ggml_type_size(src0->type);
+
+    // Total elements in dst
+    const int64_t total = ne0 * ne1 * ne2 * ne3;
+
+    const int64_t per_thread = (total + nth - 1) / nth;
+    const int64_t start = ith * per_thread;
+    const int64_t end = MIN(start + per_thread, total);
+
+    for (int64_t i = start; i < end; ++i) {
+        // Decompose linear index into 4D coordinates for dst
+        const int64_t i3 = i / (ne0 * ne1 * ne2);
+        const int64_t i2 = (i / (ne0 * ne1)) % ne2;
+        const int64_t i1 = (i / ne0) % ne1;
+        const int64_t i0 = i % ne0;
+
+        // Map to src0 coordinates using modulo
+        const int64_t si0 = i0 % ne00;
+        const int64_t si1 = i1 % ne01;
+        const int64_t si2 = i2 % ne02;
+        const int64_t si3 = i3 % ne03;
+
+        const char * src_ptr = (const char *) src0->data
+            + si0 * nb00 + si1 * nb01 + si2 * nb02 + si3 * nb03;
+        char * dst_ptr = (char *) dst->data
+            + i0 * nb0 + i1 * nb1 + i2 * nb2 + i3 * nb3;
+
+        memcpy(dst_ptr, src_ptr, type_size);
+    }
+}
+
+// ggml_compute_forward_concat
+
+static void ggml_compute_forward_concat(
+        const struct ggml_compute_params * params,
+        struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+
+    GGML_ASSERT(src0->type == src1->type);
+    GGML_ASSERT(src0->type == dst->type);
+
+    const int dim = ggml_get_op_params_i32(dst, 0);
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const size_t type_size = ggml_type_size(src0->type);
+
+    // For concat along dim, we copy src0 then src1 into dst
+    // Parallelize over the outer dimensions (dim+1 to 3)
+    // For simplicity, we handle the most common cases: dim 0, 1, 2, 3
+
+    if (dim == 0) {
+        // Concat along dimension 0 (innermost)
+        // Each "row" in higher dims: copy ne00 elements from src0, then ne10 elements from src1
+        const int64_t nr = ne01 * ne02 * ne03; // total rows (same for src0, src1, dst since ne1==ne01 etc for dim!=0)
+        const int dr = (nr + nth - 1) / nth;
+        const int ir0 = dr * ith;
+        const int ir1 = MIN(ir0 + dr, nr);
+
+        for (int64_t ir = ir0; ir < ir1; ++ir) {
+            const int64_t i3 = ir / (ne01 * ne02);
+            const int64_t i2 = (ir - i3 * ne01 * ne02) / ne01;
+            const int64_t i1 = ir - i3 * ne01 * ne02 - i2 * ne01;
+
+            // Copy src0 part
+            const char * src0_ptr = (const char *) src0->data + i1 * nb01 + i2 * nb02 + i3 * nb03;
+            char * dst_ptr = (char *) dst->data + i1 * nb1 + i2 * nb2 + i3 * nb3;
+            memcpy(dst_ptr, src0_ptr, ne00 * type_size);
+
+            // Copy src1 part
+            const char * src1_ptr = (const char *) src1->data + i1 * nb11 + i2 * nb12 + i3 * nb13;
+            memcpy(dst_ptr + ne00 * type_size, src1_ptr, ne10 * type_size);
+        }
+    } else if (dim == 1) {
+        // Concat along dimension 1
+        const int64_t nr = ne02 * ne03;
+        const int dr = (nr + nth - 1) / nth;
+        const int ir0 = dr * ith;
+        const int ir1 = MIN(ir0 + dr, nr);
+
+        for (int64_t ir = ir0; ir < ir1; ++ir) {
+            const int64_t i3 = ir / ne02;
+            const int64_t i2 = ir - i3 * ne02;
+
+            // Copy src0 part (ne01 rows of ne00 elements)
+            for (int64_t i1 = 0; i1 < ne01; ++i1) {
+                const char * src0_ptr = (const char *) src0->data + i1 * nb01 + i2 * nb02 + i3 * nb03;
+                char * dst_ptr = (char *) dst->data + i1 * nb1 + i2 * nb2 + i3 * nb3;
+                memcpy(dst_ptr, src0_ptr, ne00 * type_size);
+            }
+
+            // Copy src1 part (ne11 rows of ne10 elements, ne10 == ne00)
+            for (int64_t i1 = 0; i1 < ne11; ++i1) {
+                const char * src1_ptr = (const char *) src1->data + i1 * nb11 + i2 * nb12 + i3 * nb13;
+                char * dst_ptr = (char *) dst->data + (ne01 + i1) * nb1 + i2 * nb2 + i3 * nb3;
+                memcpy(dst_ptr, src1_ptr, ne10 * type_size);
+            }
+        }
+    } else if (dim == 2) {
+        // Concat along dimension 2
+        const int64_t nr = ne03;
+        const int dr = (nr + nth - 1) / nth;
+        const int ir0 = dr * ith;
+        const int ir1 = MIN(ir0 + dr, nr);
+
+        for (int64_t i3 = ir0; i3 < ir1; ++i3) {
+            // Copy src0 part
+            for (int64_t i2 = 0; i2 < ne02; ++i2) {
+                for (int64_t i1 = 0; i1 < ne01; ++i1) {
+                    const char * src0_ptr = (const char *) src0->data + i1 * nb01 + i2 * nb02 + i3 * nb03;
+                    char * dst_ptr = (char *) dst->data + i1 * nb1 + i2 * nb2 + i3 * nb3;
+                    memcpy(dst_ptr, src0_ptr, ne00 * type_size);
+                }
+            }
+
+            // Copy src1 part
+            for (int64_t i2 = 0; i2 < ne12; ++i2) {
+                for (int64_t i1 = 0; i1 < ne11; ++i1) {
+                    const char * src1_ptr = (const char *) src1->data + i1 * nb11 + i2 * nb12 + i3 * nb13;
+                    char * dst_ptr = (char *) dst->data + i1 * nb1 + (ne02 + i2) * nb2 + i3 * nb3;
+                    memcpy(dst_ptr, src1_ptr, ne10 * type_size);
+                }
+            }
+        }
+    } else {
+        // dim == 3: Concat along dimension 3
+        // Each thread handles a slice of dimension 3
+        const int dr = (ne03 + nth - 1) / nth;
+        const int ir0 = dr * ith;
+        const int ir1 = MIN(ir0 + dr, ne03);
+
+        // Copy src0 part
+        for (int64_t i3 = ir0; i3 < ir1; ++i3) {
+            for (int64_t i2 = 0; i2 < ne02; ++i2) {
+                for (int64_t i1 = 0; i1 < ne01; ++i1) {
+                    const char * src0_ptr = (const char *) src0->data + i1 * nb01 + i2 * nb02 + i3 * nb03;
+                    char * dst_ptr = (char *) dst->data + i1 * nb1 + i2 * nb2 + i3 * nb3;
+                    memcpy(dst_ptr, src0_ptr, ne00 * type_size);
+                }
+            }
+        }
+
+        // Copy src1 part (offset in dim 3 by ne03)
+        const int dr1 = (ne13 + nth - 1) / nth;
+        const int ir10 = dr1 * ith;
+        const int ir11 = MIN(ir10 + dr1, ne13);
+
+        for (int64_t i3 = ir10; i3 < ir11; ++i3) {
+            for (int64_t i2 = 0; i2 < ne12; ++i2) {
+                for (int64_t i1 = 0; i1 < ne11; ++i1) {
+                    const char * src1_ptr = (const char *) src1->data + i1 * nb11 + i2 * nb12 + i3 * nb13;
+                    char * dst_ptr = (char *) dst->data + i1 * nb1 + i2 * nb2 + (ne03 + i3) * nb3;
+                    memcpy(dst_ptr, src1_ptr, ne10 * type_size);
+                }
+            }
+        }
+    }
+}
