index 0cb3958..f8fe4a4 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -2120,6 +2120,42 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.use_jinja = true;
         }
     ).set_examples({LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_MAIN}).set_env("LLAMA_ARG_JINJA"));
+    add_opt(common_arg(
+        {"--chat-template-kwargs"}, "JSON",
+        "extra JSON object passed into the chat template context (default: none)\n"
+        "example: --chat-template-kwargs '{\"enable_thinking\":false}'",
+        [](common_params & params, const std::string & value) {
+            auto j = json::parse(value);
+            if (!j.is_object()) {
+                throw std::invalid_argument("expected a JSON object");
+            }
+            params.chat_template_kwargs = j.dump();
+        }
+    ).set_examples({LLAMA_EXAMPLE_MAIN, LLAMA_EXAMPLE_SERVER}).set_env("LLAMA_ARG_CHAT_TEMPLATE_KWARGS"));
+    add_opt(common_arg(
+        {"--reasoning"}, "MODE",
+        "dynamic reasoning switch (default: auto; allowed values: on, off, auto)\n"
+        "on/off also injects template var `enable_thinking` and may set defaults to save compute",
+        [](common_params & params, const std::string & value) {
+            /**/ if (value == "auto") { params.reasoning = "auto"; }
+            else if (value == "on")   { params.reasoning = "on"; }
+            else if (value == "off")  { params.reasoning = "off"; }
+            else { throw std::invalid_argument("invalid value"); }
+
+            if (value == "on" || value == "off") {
+                json j = params.chat_template_kwargs.empty() ? json::object() : json::parse(params.chat_template_kwargs);
+                if (!j.is_object()) {
+                    throw std::invalid_argument("chat_template_kwargs must be a JSON object");
+                }
+                j["enable_thinking"] = (value == "on");
+                params.chat_template_kwargs = j.dump();
+            }
+            if (value == "off") {
+                // token-level suppression: immediately force end-of-thinking once detected
+                params.reasoning_budget = 0;
+            }
+        }
+    ).set_examples({LLAMA_EXAMPLE_MAIN, LLAMA_EXAMPLE_SERVER}).set_env("LLAMA_ARG_REASONING"));
     add_opt(common_arg(
         {"--reasoning-format"}, "FORMAT",
         "reasoning format (default: deepseek; allowed values: deepseek, none)\n"
