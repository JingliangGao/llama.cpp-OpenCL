+    if (!tcim_load_library(lib_path, &g_tcim_api)) {
+        LLAMA_LOG_ERROR("Failed to load TCIM library: %s\n", tcim_get_last_error());
+        return false;
+    }
+
+    g_tcim_loaded = true;
+    return true;
+}
+
+struct kv_cache_item {
+    std::vector<tcim_tensor_t> tensors;
+    std::vector<std::string> names;
+    int seq_id = 0;
