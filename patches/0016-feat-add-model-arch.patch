+void llm_arch_model_gemma3::init_hparams(llama_model & model, llama_model_loader & ml) {
+    ml.get_key(LLM_KV_ATTENTION_LAYERNORM_RMS_EPS, model.hparams.f_norm_rms_eps);
+    // These are optional parameters for Gemma3, provide defaults if not found
+    ml.get_key(LLM_KV_EMBEDDING_SCALE, model.hparams.f_embedding_scale, false);
+    ml.get_key(LLM_KV_ATTN_LOGIT_SOFTCAPPING, model.hparams.f_attn_logit_softcapping, false);
+    ml.get_key(LLM_KV_FINAL_LOGIT_SOFTCAPPING, model.hparams.f_final_logit_softcapping, false);
+    ml.get_key(LLM_KV_RESIDUAL_SCALE, model.hparams.f_residual_scale, false);
+
+    const auto & hp = model.hparams;
+    model.type = LLM_TYPE_UNKNOWN;
+    for (const auto & e : GEMMA3_SIZE_TABLE) {
+        if (hp.n_layer == e.n_layer &&
+            (e.n_embd == 0 || hp.n_embd       == e.n_embd) &&
+            (e.n_head == 0 || hp.n_head()      == (uint32_t)e.n_head)) {
+            model.type = e.type;
+            break;
+        }
+    }
+}
+
+void llm_arch_model_gemma3::create_tensors(llama_model & model, const create_tensor_fn & create) {
+    const auto & hp = model.hparams;
+
+    const int64_t n_head        = hp.n_head();
+    const int64_t n_embd        = hp.n_embd;
+    const int64_t n_embd_head_k = hp.n_embd_head_k;
+    const int64_t n_embd_gqa    = hp.n_embd_v_gqa();
+    const int64_t n_ff          = hp.n_ff();
+    const int64_t n_vocab       = model.vocab.n_tokens();
+    const int     n_layer       = hp.n_layer;
+
+    const int TENSOR_NOT_REQUIRED = llama_model_loader::TENSOR_NOT_REQUIRED;
+    const int TENSOR_DUPLICATED   = llama_model_loader::TENSOR_DUPLICATED;
+
+    const auto tn = LLM_TN(model.arch);
+
+    model.tok_embd    = create(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"),   {n_embd, n_vocab}, 0);
+    model.output_norm = create(tn(LLM_TENSOR_OUTPUT_NORM, "weight"),   {n_embd},          0);
+    // Gemma3 uses tied weights - output.weight may not exist in GGUF, use token_embd as fallback
+    model.output      = create(tn(LLM_TENSOR_OUTPUT,      "weight"),   {n_embd, n_vocab}, TENSOR_NOT_REQUIRED);
+    if (model.output == nullptr) {
+        // Use token embeddings as output weights (tied weights)
+        model.output  = create(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"),   {n_embd, n_vocab}, TENSOR_DUPLICATED);
+    }
+
+    for (int i = 0; i < n_layer; ++i) {
+        auto & layer = model.layers[i];
+
+        // Pre-attention norm
+        layer.attn_norm = create(tn(LLM_TENSOR_ATTN_NORM, "weight", i), {n_embd}, 0);
+
+        // Separate Q, K, V weights (no bias for Gemma3)
+        // Q: {n_embd, n_head * n_embd_head_k} - full attention heads
+        layer.wq        = create(tn(LLM_TENSOR_ATTN_Q,    "weight", i), {n_embd, n_head * n_embd_head_k}, 0);
+        // K, V: {n_embd, n_embd_gqa} - GQA (grouped query attention)
+        layer.wk        = create(tn(LLM_TENSOR_ATTN_K,    "weight", i), {n_embd, n_embd_gqa},   0);
+        layer.wv        = create(tn(LLM_TENSOR_ATTN_V,    "weight", i), {n_embd, n_embd_gqa},   0);
+        // Output: {n_head * n_embd_head_k, n_embd}
+        layer.wo        = create(tn(LLM_TENSOR_ATTN_OUT,  "weight", i), {n_head * n_embd_head_k, n_embd}, 0);
+
+        // Post-attention norm (optional for Gemma3)
+        layer.attn_post_norm = create(tn(LLM_TENSOR_ATTN_POST_NORM, "weight", i), {n_embd}, TENSOR_NOT_REQUIRED);
+
+        // Q/K normalization (Gemma3 uses QK norm)
+        layer.attn_q_norm = create(tn(LLM_TENSOR_ATTN_Q_NORM, "weight", i), {n_embd_head_k}, TENSOR_NOT_REQUIRED);
+        layer.attn_k_norm = create(tn(LLM_TENSOR_ATTN_K_NORM, "weight", i), {n_embd_head_k}, TENSOR_NOT_REQUIRED);
+
+        // FFN norm
+        layer.ffn_norm  = create(tn(LLM_TENSOR_FFN_NORM,  "weight", i), {n_embd}, 0);
+
+        // FFN gates (GeGLU uses gate + up)
+        layer.ffn_gate  = create(tn(LLM_TENSOR_FFN_GATE,  "weight", i), {n_embd, n_ff}, 0);
+        layer.ffn_up    = create(tn(LLM_TENSOR_FFN_UP,    "weight", i), {n_embd, n_ff}, 0);
+        layer.ffn_down  = create(tn(LLM_TENSOR_FFN_DOWN,  "weight", i), {n_ff,   n_embd}, 0);
+        layer.ffn_post_norm = create(tn(LLM_TENSOR_FFN_POST_NORM, "weight", i), {n_embd}, 0);
+    }
+}
