-bool llama_kv_cache_unified::get_can_resize(uint32_t size) const {
-    // 用于存储每个设备上的kv_cache内存/显存
-    struct device_memory_info {
-        size_t required_mem = 0;
-        size_t current_mem = 0;
-    };
-    std::map<ggml_backend_dev_t, device_memory_info> device_mem_info;
-    const int32_t n_layer = hparams.n_layer;
-
-    for (int i = 0; i < n_layer; i++) {
-        const uint32_t n_embd_k_gqa = hparams.n_embd_k_gqa(i) + hparams.n_embd_k_s();
-        const uint32_t n_embd_v_gqa = hparams.n_embd_v_gqa(i) + hparams.n_embd_v_s();
-        size_t layer_mem_size = size * (n_embd_k_gqa * ggml_type_size(type_k) +  n_embd_v_gqa * ggml_type_size(type_v));
-        size_t layer_current_mem = this->size * (n_embd_k_gqa * ggml_type_size(type_k) +  n_embd_v_gqa * ggml_type_size(type_v));
-
-        // 获取当前层的设备
-        ggml_backend_dev_t device = devs[i];
-
-        // 累加到对应设备的内存需求
-        device_mem_info[device].required_mem += layer_mem_size;
-        device_mem_info[device].current_mem += layer_current_mem;
-    }
-
-    for (const auto& [device, mem_info] : device_mem_info) {
-        size_t free, total;
-
-        const char * dev_name = ggml_backend_dev_name(device);
-        if (strcmp(dev_name, "CPU") == 0) {
-            cpu_get_memory(&free, &total);
-        } else {
-            ggml_backend_dev_memory(device, &free, &total);
-        }
-
-        size_t additional_mem = mem_info.required_mem - mem_info.current_mem;
-
-        LLAMA_LOG_DEBUG("%s: Device %s free: %8.2f MiB, total: %8.2f MiB, kv_self_resize requires %8.2f MiB, \n", __func__,
-                    ggml_backend_dev_name(device), free / 1024.0 / 1024.0, total / 1024.0 / 1024.0,  mem_info.required_mem / 1024.0 / 1024.0);
-
-        if (mem_info.required_mem > free * 0.5 ||
-            (free - additional_mem) < total * 0.5) {
-            return false;
-        }
-    }
-
-    return true;
-}
