diff --git a/ggml/src/ggml-vmem.cpp b/ggml/src/ggml-vmem.cpp
new file mode 100644
index 0000000..d19b335
--- /dev/null
+++ b/ggml/src/ggml-vmem.cpp
@@ -0,0 +1,211 @@
+#include "ggml-vmem.h"
+#include "ggml-impl.h"
+
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+
+// 注册表：每种 backend 一份 iface（按 enum 索引）
+constexpr int kMaxBackends = 8;
+ggml_vmem_backend_iface g_registry[kMaxBackends]   = {};
+bool                    g_registered[kMaxBackends] = {};
+
+const ggml_vmem_backend_iface * find_iface(ggml_vmem_backend_type backend) {
+    int idx = static_cast<int>(backend);
+    if (idx < 0 || idx >= kMaxBackends) return nullptr;
+    if (!g_registered[idx])             return nullptr;
+    return &g_registry[idx];
+}
+
+} // namespace
+
+// 分配器实例：保存所选后端 + 后端私有 impl 指针
+struct ggml_vmem_allocator {
+    ggml_vmem_backend_type            backend;
+    const ggml_vmem_backend_iface *   iface;
+    void *                            impl;
+};
+
+// ============================================================================
+// 后端注册
+// ============================================================================
+
+void ggml_vmem_register_backend(
+        ggml_vmem_backend_type backend,
+        const ggml_vmem_backend_iface * iface) {
+    int idx = static_cast<int>(backend);
+    if (idx < 0 || idx >= kMaxBackends || iface == nullptr) {
+        GGML_LOG_WARN("ggml-vmem: invalid backend registration (idx=%d)\n", idx);
+        return;
+    }
+    g_registry[idx]   = *iface;
+    g_registered[idx] = true;
+}
+
+bool ggml_vmem_backend_available(ggml_vmem_backend_type backend) {
+    return find_iface(backend) != nullptr;
+}
+
+ggml_vmem_backend_type ggml_vmem_detect_available_backend(void) {
+    for (int i = 1; i < kMaxBackends; i++) {
+        if (g_registered[i]) {
+            return static_cast<ggml_vmem_backend_type>(i);
+        }
+    }
+    return GGML_VMEM_BACKEND_NONE;
+}
+
+// ============================================================================
+// 生命周期
+// ============================================================================
+
+ggml_vmem_allocator_t ggml_vmem_allocator_init(
+        ggml_vmem_backend_type backend,
+        const ggml_vmem_config * config) {
+    const ggml_vmem_backend_iface * iface = find_iface(backend);
+    if (!iface || !iface->init) {
+        GGML_LOG_ERROR("ggml-vmem: backend %d is not registered or missing init()\n",
+                       static_cast<int>(backend));
+        return nullptr;
+    }
+
+    void * impl = iface->init(config);
+    if (!impl) {
+        return nullptr;
+    }
+
+    auto * alloc = new ggml_vmem_allocator();
+    alloc->backend = backend;
+    alloc->iface   = iface;
+    alloc->impl    = impl;
+    return alloc;
+}
+
+void ggml_vmem_allocator_free(ggml_vmem_allocator_t alloc) {
+    if (!alloc) return;
+    if (alloc->iface && alloc->iface->free && alloc->impl) {
+        alloc->iface->free(alloc->impl);
+    }
+    delete alloc;
+}
+
+// ============================================================================
+// 操作转发宏
+// ============================================================================
+
+#define VMEM_CALL_RET(alloc, method, default_ret, ...)            \
+    do {                                                           \
+        if (!(alloc) || !(alloc)->iface || !(alloc)->iface->method) { \
+            return (default_ret);                                  \
+        }                                                          \
+        return (alloc)->iface->method((alloc)->impl, ##__VA_ARGS__); \
+    } while (0)
+
+#define VMEM_CALL_VOID(alloc, method, ...)                         \
+    do {                                                           \
+        if (!(alloc) || !(alloc)->iface || !(alloc)->iface->method) return; \
+        (alloc)->iface->method((alloc)->impl, ##__VA_ARGS__);     \
+    } while (0)
+
+// ============================================================================
+// 内存管理 API 转发
+// ============================================================================
+
+size_t ggml_vmem_reserve_pages(ggml_vmem_allocator_t alloc, size_t free_memory) {
+    VMEM_CALL_RET(alloc, reserve_pages, 0, free_memory);
+}
+
+bool ggml_vmem_grow_sync(ggml_vmem_allocator_t alloc, size_t num_tokens) {
+    VMEM_CALL_RET(alloc, grow_sync, false, num_tokens);
+}
+
+void ggml_vmem_reclaim(ggml_vmem_allocator_t alloc, size_t num_tokens_to_keep) {
+    VMEM_CALL_VOID(alloc, reclaim, num_tokens_to_keep);
+}
+
+void ggml_vmem_release_all_pages(ggml_vmem_allocator_t alloc) {
+    VMEM_CALL_VOID(alloc, release_all_pages);
+}
+
+void ggml_vmem_get_device_memory(
+        ggml_vmem_allocator_t alloc,
+        size_t * free_bytes,
+        size_t * total_bytes) {
+    if (free_bytes)  *free_bytes  = 0;
+    if (total_bytes) *total_bytes = 0;
+    if (!alloc || !alloc->iface || !alloc->iface->get_device_memory) return;
+    alloc->iface->get_device_memory(alloc->impl, free_bytes, total_bytes);
+}
+
+void ggml_vmem_set_async(ggml_vmem_allocator_t alloc, bool enabled) {
+    VMEM_CALL_VOID(alloc, set_async, enabled);
+}
+
+void ggml_vmem_step_async(ggml_vmem_allocator_t alloc, size_t total_tokens_needed) {
+    VMEM_CALL_VOID(alloc, step_async, total_tokens_needed);
+}
+
+void * ggml_vmem_get_k_ptr(ggml_vmem_allocator_t alloc, int layer_idx) {
+    VMEM_CALL_RET(alloc, get_k_ptr, nullptr, layer_idx);
+}
+
+void * ggml_vmem_get_v_ptr(ggml_vmem_allocator_t alloc, int layer_idx) {
+    VMEM_CALL_RET(alloc, get_v_ptr, nullptr, layer_idx);
+}
+
+ggml_backend_buffer_t ggml_vmem_buffer_from_ptr(
+        ggml_vmem_allocator_t alloc,
+        void * ptr,
+        size_t size) {
+    VMEM_CALL_RET(alloc, buffer_from_ptr, nullptr, ptr, size);
+}
+
+void ggml_vmem_defrag_move(
+        ggml_vmem_allocator_t alloc,
+        const uint32_t * ids,
+        uint32_t n_ids,
+        bool v_trans,
+        uint32_t kv_size) {
+    VMEM_CALL_VOID(alloc, defrag_move, ids, n_ids, v_trans, kv_size);
+}
+
+// ============================================================================
+// 统计
+// ============================================================================
+
+size_t ggml_vmem_get_virtual_size(ggml_vmem_allocator_t alloc) {
+    VMEM_CALL_RET(alloc, get_virtual_size, 0);
+}
+
+size_t ggml_vmem_get_num_mapped_pages(ggml_vmem_allocator_t alloc) {
+    VMEM_CALL_RET(alloc, get_num_mapped_pages, 0);
+}
+
+size_t ggml_vmem_get_num_free_pages(ggml_vmem_allocator_t alloc) {
+    VMEM_CALL_RET(alloc, get_num_free_pages, 0);
+}
+
+size_t ggml_vmem_get_tokens_per_page(ggml_vmem_allocator_t alloc) {
+    VMEM_CALL_RET(alloc, get_tokens_per_page, 0);
+}
+
+size_t ggml_vmem_get_page_size_bytes(ggml_vmem_allocator_t alloc) {
+    VMEM_CALL_RET(alloc, get_page_size_bytes, 0);
+}
+
+ggml_vmem_stats ggml_vmem_get_stats(ggml_vmem_allocator_t alloc) {
+    ggml_vmem_stats s = {};
+    if (!alloc || !alloc->iface) return s;
+    s.virtual_size     = ggml_vmem_get_virtual_size(alloc);
+    s.mapped_pages     = ggml_vmem_get_num_mapped_pages(alloc);
+    s.free_pool_pages  = ggml_vmem_get_num_free_pages(alloc);
+    s.tokens_per_page  = ggml_vmem_get_tokens_per_page(alloc);
+    s.page_size_bytes  = ggml_vmem_get_page_size_bytes(alloc);
+    return s;
+}
+
+ggml_vmem_backend_type ggml_vmem_get_backend(ggml_vmem_allocator_t alloc) {
+    if (!alloc) return GGML_VMEM_BACKEND_NONE;
+    return alloc->backend;
+}
