-    char * pb = (char *)packed_B;
-    char * ph = (char *)packed_B + (QK_K / 2) * TILE_N;
-    for (int k = 0; k < QK_K / 64; ++k) {
-        // pack 2 groups { n, g,  k} to {g, k/4, 4n}
-        //          e.g. {16, 2, 32} to {2,   8, 64}
-        for (int n = 0; n < TILE_N; ++n) {
