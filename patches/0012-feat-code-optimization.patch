-static void gguf_split(const split_params & split_params) {
-    struct ggml_context * ctx_meta = NULL;
-
-    struct gguf_init_params params = {
-        /*.no_alloc = */ true,
-        /*.ctx      = */ &ctx_meta,
-    };
-
-    std::ifstream f_input(split_params.input.c_str(), std::ios::binary);
