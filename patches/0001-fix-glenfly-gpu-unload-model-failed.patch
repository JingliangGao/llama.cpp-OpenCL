+/**
+ * @brief Retrieves the driver support max allocate size
+ *
+ * This function returns the max gpu memmory size, which ocl driver support
+ *
+ * @param buft Pointer to the buffer type context (unused in this
+ * implementation).
+ * @return The the max gpu memory size in bytes (2G)
+ */
+static size_t ggml_backend_ponn_buffer_get_max_size(ggml_backend_buffer_type_t buft) {
+    GGML_PONN_TRACE();
+    size_t max_allocate_size = ponnGetMaxMemoryAllocateSize();
+    return max_allocate_size;
+    GGML_UNUSED(buft);
+}
+
 /**
  * @brief Calculates the allocation size required for a tensor in a PONN buffer.
