+static json context_merge(json a, const json & b) {
+    if (a.is_null()) {
+        a = json::object();
+    }
+    if (b.is_object()) {
+        for (const auto & kv : b.items()) {
+            a[kv.key()] = kv.value();
+        }
+    }
+    return a;
+}
