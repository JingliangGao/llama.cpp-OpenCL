+    std::shared_ptr<HoumoEmbeddingLayer> embedding_layer_;
+    std::map<std::string, lora_item> lora_map;
+    tcim_tensor_t lora_mask_float_ = nullptr;
+    std::map<int, int> kv_offset_;
+    tcim_tensor_t prefill_output_raw_ = nullptr;
+    tcim_tensor_t decode_output_raw_ = nullptr;
+};
+
+// 封装数据类型无关的操作
+template <typename T>
+void SetInputData(tcim_tensor_t tensor, int batch_size, int value) {
+    std::vector<T> data_vec(batch_size, value);
+    g_tcim_api.tcim_tensor_copy_from_host(tensor, data_vec.data(), g_tcim_api.tcim_tensor_get_mem_size(tensor), 0);
+}
+
+template <typename T>
+void SetInputData(tcim_tensor_t tensor, std::vector<int32_t> &int32_vec) {
+    std::vector<T> data_vec;
+    for (auto val: int32_vec) {
+        data_vec.push_back(static_cast<T>(val));
+    }
+    g_tcim_api.tcim_tensor_copy_from_host(tensor, data_vec.data(), g_tcim_api.tcim_tensor_get_mem_size(tensor), 0);
+}
+
+void HouMoLLModel::Impl::cleanup_tensors() {
+    for (auto& pair : prefill_input_map_) {
+        if (pair.second) g_tcim_api.tcim_tensor_destroy(pair.second);
+    }
+    prefill_input_map_.clear();
+
+    for (auto& pair : prefill_output_map_) {
+        if (pair.second) g_tcim_api.tcim_tensor_destroy(pair.second);
+    }
+    prefill_output_map_.clear();
+
+    for (auto& pair : decode_input_map_) {
+        if (pair.second) g_tcim_api.tcim_tensor_destroy(pair.second);
+    }
+    decode_input_map_.clear();
+
+    for (auto& pair : decode_output_map_) {
+        if (pair.second) g_tcim_api.tcim_tensor_destroy(pair.second);
+    }
+    decode_output_map_.clear();
+
+    if (lora_mask_float_) {
+        g_tcim_api.tcim_tensor_destroy(lora_mask_float_);
+        lora_mask_float_ = nullptr;
+    }
+
+    if (prefill_output_raw_) {
+        g_tcim_api.tcim_tensor_destroy(prefill_output_raw_);
+        prefill_output_raw_ = nullptr;
+    }
+    if (decode_output_raw_) {
+        g_tcim_api.tcim_tensor_destroy(decode_output_raw_);
+        decode_output_raw_ = nullptr;
+    }
+
+    for (auto& pair : kv_cache_) {
+        for (auto& t : pair.second.tensors) {
+            if (t) g_tcim_api.tcim_tensor_destroy(t);
+        }
+    }
+    kv_cache_.clear();
+
+    if (prefill_model_) {
+        g_tcim_api.tcim_module_destroy(prefill_model_);
+        prefill_model_ = nullptr;
+    }
+    if (decode_model_) {
+        g_tcim_api.tcim_module_destroy(decode_model_);
+        decode_model_ = nullptr;
+    }
+}
+
+void static read_tensor_to_buffer(const std::string &file_name, size_t offset,
+                                  size_t size, std::vector<char> &buffer) {
+    // 打开输入文件
+    std::ifstream input_file(file_name, std::ios::binary);
+    if (!input_file.is_open()) {
+        LLAMA_LOG_ERROR("%s: failed to open file: %s\n", __func__,
+                        file_name.c_str());
+        return;
+    }
+
+    // 移动到偏移位置
+    input_file.seekg(offset, std::ios::beg);
+    if (input_file.fail()) {
+        LLAMA_LOG_ERROR("%s: failed to seek to offset: %zu in file: %s\n",
+                        __func__, offset, file_name.c_str());
+        input_file.close();
+        return;
+    }
+
+    // 读取数据
+    input_file.read(buffer.data(), size);
+    if (input_file.fail()) {
+        LLAMA_LOG_ERROR("%s: failed to read %zu bytes from file: %s\n",
+                        __func__, size, file_name.c_str());
+        input_file.close();
+        return;
+    }
+}
+
+static std::vector<int> parse_deviceids() {
+    std::vector<int> deviceIds;
+    const char *device_id_str = std::getenv("HOUMO_DEVICE_ID");
+
+    if (device_id_str == nullptr) {
+        deviceIds.push_back(0);
+        return deviceIds;
+    }
+
+    std::string deviceList(device_id_str);
+    std::istringstream iss(deviceList);
+    std::string token;
+
+    while (std::getline(iss, token, ',')) {
+        try {
+            // 转换为整数并添加到列表
+            deviceIds.push_back(std::stoi(token));
+        } catch (const std::invalid_argument &) {
+            LLAMA_LOG_ERROR("Invalid device ID: %s", token.c_str());
+            deviceIds = {0};
+            return deviceIds;
+        } catch (const std::out_of_range &) {
+            LLAMA_LOG_ERROR("Device ID out of range: %s", token.c_str());
+            deviceIds = {0};
+            return deviceIds;
+        }
+    }
+
+    return deviceIds;
+}
+
+void HouMoLLModel::Impl::parser_gguf_parameters(struct gguf_context *ctx) {
+    auto key_id = gguf_find_key(ctx, kGeneralArch.c_str());
+    if (key_id < 0) {
+        LLAMA_LOG_INFO("%s: failed to find key %s in gguf file\n", __func__,
+                        kGeneralArch.c_str());
+        return;
+    }
+    std::string model_arch = gguf_get_val_str(ctx, key_id);
+    std::string key = model_arch + kBlockCountEx;
+    key_id = gguf_find_key(ctx, key.c_str());
+    if (key_id < 0) {
+        LLAMA_LOG_INFO("%s: not found key %s in gguf file\n", __func__,
+                        key.c_str());
+    } else {
+        n_blocks_ = gguf_get_val_u32(ctx, key_id);
+    }
+    key = model_arch + kEmbeddingLengthEx;
+    key_id = gguf_find_key(ctx, key.c_str());
+    if (key_id < 0) {
+        LLAMA_LOG_INFO("%s: not found key %s in gguf file\n", __func__,
+                        key.c_str());
+    } else {
+        n_embd_ = gguf_get_val_u32(ctx, key_id);
+    }
+    // 解析hmm.info
+    key_id = gguf_find_key(ctx, kHmmInfo.c_str());
+    if (key_id < 0) {
+        LLAMA_LOG_INFO("%s: not found key %s in gguf file\n", __func__,
+                        kHmmInfo.c_str());
+        return;
+    }
+    auto hmm_info_str = gguf_get_val_str(ctx, key_id);
+    LLAMA_LOG_INFO("%s: hmm_info: %s\n", __func__, hmm_info_str);
+    try {
+        // 解析hmm.info
+        auto hmm_info = json::parse(hmm_info_str);
+        if (hmm_info.contains("device_num")) {
+            device_num_ = hmm_info["device_num"];
+        }
+
+    } catch (const json::parse_error &e) {
+        LLAMA_LOG_ERROR("%s: failed to parse hmm_info: %s\n", __func__,
+                        e.what());
+        return;
+    }
+}
+
+bool HouMoLLModel::Impl::houmo_load_fromfile(llama_model_loader &loader) {
+    if (!load_tcim_library()) {
+        return false;
+    }
+
+    std::string file_name = loader.fname_;
+    gguf_context* ctx = loader.meta.get();
+    LLAMA_LOG_INFO("HouMoLLModel::houmo_load after gguf_init_from_file\n");
+    // 从gguf文件中加载hmmodel的device_ids信息
+    auto device_ids = parse_deviceids();
+    if (device_num_ == 2 && device_ids.size() == 1) {
+        // 单卡模型，但是模型是双卡模型，需要将device_ids 扩展为{0,1}
+        device_ids = {0, 1};
+        LLAMA_LOG_WARN("dual card model, need to set device_ids to {0,1}");
+    } else if (device_num_ == 1 && device_ids.size() > 1) {
+        // 模型是单卡模型，需要将device_ids 缩小为{0}
+        device_ids = {0};
+        LLAMA_LOG_WARN(
+            "single card model, set device_ids size > 1, need to "
+            "resize device_ids to {0}");
+    } else if ( device_num_ == 4 && device_ids.size() == 1) {
+        // 模型是四卡模型，需要将device_ids 扩展为{0,1,2,3}
+        device_ids = {0, 1, 2, 3};
+        LLAMA_LOG_WARN(
+            "4 card model, need to set device_ids to {0,1,2,3}");
+    } else {
+        LLAMA_LOG_INFO("run models in %zu cards", device_ids.size());
+    }
+    // load model
+    tcim_dev_manager_t dev_manager = g_tcim_api.tcim_dev_manager_create(device_ids.data(), device_ids.size(), "Xh2HalBackend");
+    if (!dev_manager) {
+        LLAMA_LOG_ERROR("Failed to create dev_manager\n");
+        return false;
+    }
+    tcim_weight_manager_t wm = g_tcim_api.tcim_weight_manager_create(dev_manager);
+    g_tcim_api.tcim_dev_manager_destroy(dev_manager);
+    if (!wm) {
+        LLAMA_LOG_ERROR("Failed to create weight_manager\n");
+        return false;
+    }
+
+    std::vector<std::string> dummy_tensor_names;
+    // 防止更高效使用内存，这个将prefill 设置为dummy_tensor_names
+    for (int idx = 0; idx < n_blocks_; idx++) {
+        std::string k_cache_name = "model_layers_" +
+                                   std::to_string(idx) +
+                                   "_self_attn_kcache_input";
+        std::string v_cache_name = "model_layers_" +
+                                   std::to_string(idx) +
+                                   "_self_attn_vcache_input";
+        dummy_tensor_names.push_back(k_cache_name);
+        dummy_tensor_names.push_back(v_cache_name);
+    }
+    // 是否开启lazy mode，默认开启
+    bool enable_lazy_mode = !loader.use_mmap;
+    if (const char *env = std::getenv("LLAMA_ENABLE_LAZY_MODE")) {
+        enable_lazy_mode = (std::string(env) == "1");
+    }
+    // 1. 加载 embedding
+    const int n_tensors = gguf_get_n_tensors(ctx);
+    for (int i = 0; i < n_tensors; ++i) {
+        const char *name = gguf_get_tensor_name(ctx, i);
+        LLAMA_LOG_INFO("tensor[%d]: name = %s\n", i, name);
+        const size_t size = gguf_get_tensor_size(ctx, i);
+        size_t offset = gguf_get_tensor_offset(ctx, i) + gguf_get_meta_size(ctx);
+        if (strncmp(name, "quant_embedding.bin", strlen("quant_embedding.bin")) ==
+            0) {
+            std::vector<char> buffer(size);
+            read_tensor_to_buffer(file_name, offset, size, buffer);
+            embedding_layer_ =
+                std::make_shared<HoumoEmbeddingLayer>(file_name, offset, size);
+        } else if (strncmp(name, "prefill.hmm", strlen("prefill.hmm")) == 0) {
+            // load prefill
+            tcim_module_option_t option_prefill = g_tcim_api.tcim_module_option_create(wm);
+            if (dummy_tensor_names.size() > 0) {
+                std::vector<const char*> dummy_names;
+                for (const auto& s : dummy_tensor_names) {
+                    dummy_names.push_back(s.c_str());
+                }
+                g_tcim_api.tcim_module_option_set_dummy_tensors(option_prefill, dummy_names.data(), dummy_names.size());
+            }
+            g_tcim_api.tcim_module_option_enable_lazy_mode(option_prefill, enable_lazy_mode);
+            g_tcim_api.tcim_module_option_set_model_offset(option_prefill, offset, size);
+            prefill_model_ = g_tcim_api.tcim_module_create();
+            tcim_status_t status = g_tcim_api.tcim_module_load_model_file(prefill_model_, file_name.c_str(), option_prefill);
+            g_tcim_api.tcim_module_option_destroy(option_prefill);
+            if (status != TCIM_OK) {
+                LLAMA_LOG_ERROR("LoadModel failed: status == %d\n", (int)status);
+                g_tcim_api.tcim_weight_manager_destroy(wm);
+                return false;
+            }
+            LLAMA_LOG_INFO("%s: succeed to load prefill.hmm\n", __func__);
+        } else if (strncmp(name, "decoder.hmm", strlen("decoder.hmm")) == 0) {
+            // load decode
+            tcim_module_option_t option_decode = g_tcim_api.tcim_module_option_create(wm);
+            g_tcim_api.tcim_module_option_enable_lazy_mode(option_decode, enable_lazy_mode);
+            g_tcim_api.tcim_module_option_set_model_offset(option_decode, offset, size);
+            decode_model_ = g_tcim_api.tcim_module_create();
+            tcim_status_t status = g_tcim_api.tcim_module_load_model_file(decode_model_, file_name.c_str(), option_decode);
+            g_tcim_api.tcim_module_option_destroy(option_decode);
+            if (status != TCIM_OK) {
+                LLAMA_LOG_ERROR("LoadModel failed: status == %d\n", (int)status);
+                g_tcim_api.tcim_weight_manager_destroy(wm);
+                return false;
+            }
+            LLAMA_LOG_INFO("%s: succeed to load decode.hmm\n", __func__);
+        } else {
+            LLAMA_LOG_INFO("skip tensor[%d]: name = %s, size = %zu\n", i, name,
+                           size);
+        }
+    }
+    g_tcim_api.tcim_weight_manager_destroy(wm);
+    return true;
+}
+
+bool HouMoLLModel::Impl::houmo_load(llama_model_loader &loader) {
+    if (!load_tcim_library()) {
+        return false;
+    }
+
+    gguf_context* ctx = loader.meta.get();
+    parser_gguf_parameters(ctx);
+    // 从gguf文件中加载hmmodel的device_ids信息
+    auto device_ids = parse_deviceids();
+    if (device_num_ == 2 && device_ids.size() == 1) {
+        // 单卡模型，但是模型是双卡模型，需要将device_ids 扩展为{0,1}
+        device_ids = {0, 1};
+        LLAMA_LOG_WARN("dual card model, need to set device_ids to {0,1}");
+    } else if (device_num_ == 1 && device_ids.size() > 1) {
+        // 模型是单卡模型，需要将device_ids 缩小为{0}
+        device_ids = {0};
+        LLAMA_LOG_WARN(
+            "single card model, set device_ids size > 1, need to "
+            "resize device_ids to {0}");
+    } else if ( device_num_ == 4 && device_ids.size() == 1) {
+        // 模型是四卡模型，需要将device_ids 扩展为{0,1,2,3}
+        device_ids = {0, 1, 2, 3};
+        LLAMA_LOG_WARN(
+            "4 card model, need to set device_ids to {0,1,2,3}");
+    } else {
+        LLAMA_LOG_INFO("run models in %zu cards", device_ids.size());
+    }
+    // load model
+    tcim_dev_manager_t dev_manager = g_tcim_api.tcim_dev_manager_create(device_ids.data(), device_ids.size(), "Xh2HalBackend");
+    if (!dev_manager) {
+        LLAMA_LOG_ERROR("Failed to create dev_manager\n");
+        return false;
+    }
+    tcim_weight_manager_t wm = g_tcim_api.tcim_weight_manager_create(dev_manager);
+    g_tcim_api.tcim_dev_manager_destroy(dev_manager);
+    if (!wm) {
+        LLAMA_LOG_ERROR("Failed to create weight_manager\n");
+        return false;
+    }
+
+    std::vector<std::string> dummy_tensor_names;
+    // 防止更高效使用内存，这个将prefill 设置为dummy_tensor_names
+    for (int idx = 0; idx < n_blocks_; idx++) {
+        std::string k_cache_name = "model_layers_" +
+                                   std::to_string(idx) +
+                                   "_self_attn_kcache_input";
+        std::string v_cache_name = "model_layers_" +
+                                   std::to_string(idx) +
+                                   "_self_attn_vcache_input";
+        dummy_tensor_names.push_back(k_cache_name);
+        dummy_tensor_names.push_back(v_cache_name);
+    }
+    bool enable_lazy_mode = true;
+    // 1. 加载 embedding
+    const int n_tensors = gguf_get_n_tensors(ctx);
+    char *model_addr = (char *)gguf_get_model_addr(ctx);
+    if (model_addr == nullptr) {
+        g_tcim_api.tcim_weight_manager_destroy(wm);
+        return houmo_load_fromfile(loader);
+    }
+    LLAMA_LOG_INFO("HouMoLLModel::houmo_load from model_addr\n");
+
+    bool retval = true;
+    for (int i = 0; i < n_tensors; ++i) {
+        const char *name = gguf_get_tensor_name(ctx, i);
+        const size_t size = gguf_get_tensor_size(ctx, i);
+        size_t offset = gguf_get_tensor_offset(ctx, i) + gguf_get_meta_size(ctx);
+        char *raw_data = model_addr + offset;
+
+        LLAMA_LOG_INFO("tensor[%d]: name = %s， size = %zu\n", i, name, size);
+        if (strncmp(name, "quant_embedding.bin", strlen("quant_embedding.bin")) ==
+            0) {
+            embedding_layer_ =
+                std::make_shared<HoumoEmbeddingLayer>(raw_data, size);
+        } else if (strncmp(name, "prefill.hmm", strlen("prefill.hmm")) == 0) {
+            // load prefill
+            tcim_module_option_t option_prefill = g_tcim_api.tcim_module_option_create(wm);
+            if (dummy_tensor_names.size() > 0) {
+                std::vector<const char*> dummy_names;
+                for (const auto& s : dummy_tensor_names) {
+                    dummy_names.push_back(s.c_str());
+                }
+                g_tcim_api.tcim_module_option_set_dummy_tensors(option_prefill, dummy_names.data(), dummy_names.size());
+            }
+            g_tcim_api.tcim_module_option_enable_lazy_mode(option_prefill, enable_lazy_mode);
+            prefill_model_ = g_tcim_api.tcim_module_create();
+            tcim_status_t status = g_tcim_api.tcim_module_load_model_mem(prefill_model_, raw_data, size, option_prefill);
+            g_tcim_api.tcim_module_option_destroy(option_prefill);
+            if (status != TCIM_OK) {
+                LLAMA_LOG_ERROR("LoadModel failed: status == %d\n", (int)status);
+                retval = false;
+            }
+            LLAMA_LOG_INFO("%s: succeed to load prefill.hmm\n", __func__);
+        } else if (strncmp(name, "decoder.hmm", strlen("decoder.hmm")) == 0) {
+            // load decode
+            tcim_module_option_t option_decode = g_tcim_api.tcim_module_option_create(wm);
+            g_tcim_api.tcim_module_option_enable_lazy_mode(option_decode, enable_lazy_mode);
+            decode_model_ = g_tcim_api.tcim_module_create();
+            tcim_status_t status = g_tcim_api.tcim_module_load_model_mem(decode_model_, raw_data, size, option_decode);
+            g_tcim_api.tcim_module_option_destroy(option_decode);
+            if (status != TCIM_OK) {
+                LLAMA_LOG_ERROR("LoadModel failed: status == %d\n", (int)status);
+                retval = false;
+            }
+            LLAMA_LOG_INFO("%s: succeed to load decode.hmm\n", __func__);
+        } else {
+            LLAMA_LOG_INFO("skip tensor[%d]: name = %s, size = %zu\n", i, name,
+                           size);
+        }
+        if (!retval) {
+            break;
+        }
+    }
+    g_tcim_api.tcim_weight_manager_destroy(wm);
+    return retval;
+}
+
+void HouMoLLModel::Impl::houmo_init(int seq_max) {
+    // init prefill
+    int input_num = g_tcim_api.tcim_module_get_input_num(prefill_model_);
+    assert(input_num > 3);
+    for (int idx = 0; idx < input_num; idx++) {
+        const char* input_name_c = g_tcim_api.tcim_module_get_input_name(prefill_model_, idx);
+        if (!input_name_c) continue;
+        std::string input_name(input_name_c);
+        if (input_name.find("past_key_cache_") != std::string::npos ||
+            input_name.find("_self_attn_vcache") != std::string::npos ||
+            input_name.find("_self_attn_kcache") != std::string::npos) {
+            continue;
+        }
+        input_names_.push_back(input_name);
+        LLAMA_LOG_INFO("%s: prefill input_name: %s\n", __func__,
+                       input_name.c_str());
+        tcim_tensor_info_t input_info = g_tcim_api.tcim_module_get_input_info(prefill_model_, input_name_c);
+        if (!input_info) continue;
+        tcim_tensor_info_t input_info_contiguous = g_tcim_api.tcim_tensor_info_as_contiguous(input_info);
+        g_tcim_api.tcim_tensor_info_destroy(input_info);
+        tcim_tensor_t input_tensor = g_tcim_api.tcim_tensor_create_host(input_info_contiguous, 0, nullptr);
+        g_tcim_api.tcim_tensor_info_destroy(input_info_contiguous);
+        if (input_tensor) {
+            prefill_input_map_.insert(std::pair<std::string, tcim_tensor_t>(input_name, input_tensor));
+        }
+    }
+    // 填充prefill_length_ & n_prefill_batch_
+    n_prefill_batch_ = 1;
+    if (!prefill_input_map_.empty()) {
+        const char* first_name = g_tcim_api.tcim_module_get_input_name(prefill_model_, 0);
+        if (first_name) {
+            auto it = prefill_input_map_.find(first_name);
+            if (it != prefill_input_map_.end() && it->second) {
+                tcim_tensor_info_t info = g_tcim_api.tcim_tensor_get_info(it->second);
+                if (info) {
+                    size_t shape_num = g_tcim_api.tcim_tensor_info_get_shape_num(info);
+                    if (shape_num >= 2) {
+                        int64_t dim0 = g_tcim_api.tcim_tensor_info_get_shape_dim(info, 0);
+                        int64_t dim1 = g_tcim_api.tcim_tensor_info_get_shape_dim(info, 1);
+                        prefill_length_ = (dim0 * dim1) / n_prefill_batch_;
+                    }
+                    g_tcim_api.tcim_tensor_info_destroy(info);
+                }
+            }
+        }
+    }
+    // 填充prefill 的output
+    int output_num = g_tcim_api.tcim_module_get_output_num(prefill_model_);
+    for (int idx = 0; idx < output_num; idx++) {
+        const char* output_name_c = g_tcim_api.tcim_module_get_output_name(prefill_model_, idx);
+        if (!output_name_c) continue;
+        std::string output_name(output_name_c);
+        LLAMA_LOG_INFO("%s: prefill output_name: %s\n", __func__,
+                       output_name.c_str());
+        tcim_tensor_info_t output_info = g_tcim_api.tcim_module_get_output_info(prefill_model_, output_name_c);
+        if (!output_info) continue;
+        tcim_tensor_info_t output_info_contiguous = g_tcim_api.tcim_tensor_info_as_contiguous(output_info);
+        g_tcim_api.tcim_tensor_info_destroy(output_info);
+        tcim_tensor_info_t output_info_float = g_tcim_api.tcim_tensor_info_as_type(output_info_contiguous, TCIM_FLOAT32);
+        g_tcim_api.tcim_tensor_info_destroy(output_info_contiguous);
+        tcim_tensor_t output_tensor = g_tcim_api.tcim_tensor_create_host(output_info_float, 0, nullptr);
+        g_tcim_api.tcim_tensor_info_destroy(output_info_float);
+        if (output_tensor) {
+            prefill_output_map_.insert(std::pair<std::string, tcim_tensor_t>(output_name, output_tensor));
+            prefill_output_names_.push_back(output_name);
+        }
+    }
+    // init decode
+    int input_num_decode = g_tcim_api.tcim_module_get_input_num(decode_model_);
+    for (int idx = 0; idx < input_num_decode; idx++) {
+        const char* input_name_c = g_tcim_api.tcim_module_get_input_name(decode_model_, idx);
+        if (!input_name_c) continue;
+        std::string input_name(input_name_c);
+        if (input_name.find("past_key_cache_") != std::string::npos ||
+            input_name.find("_self_attn_vcache") != std::string::npos ||
+            input_name.find("_self_attn_kcache") != std::string::npos) {
+            continue;
+        }
+        LLAMA_LOG_INFO("%s: decode input_name: %s\n", __func__,
+                       input_name.c_str());
+        tcim_tensor_info_t input_info = g_tcim_api.tcim_module_get_input_info(decode_model_, input_name_c);
+        if (!input_info) continue;
+        tcim_tensor_info_t input_info_contiguous = g_tcim_api.tcim_tensor_info_as_contiguous(input_info);
+        g_tcim_api.tcim_tensor_info_destroy(input_info);
+        tcim_tensor_t input_tensor = g_tcim_api.tcim_tensor_create_host(input_info_contiguous, 0, nullptr);
+        g_tcim_api.tcim_tensor_info_destroy(input_info_contiguous);
+        if (input_tensor) {
+            decode_input_map_.insert(std::pair<std::string, tcim_tensor_t>(input_name, input_tensor));
+        }
+    }
+    // 填充n_decode_batch_
+    if (!decode_input_map_.empty()) {
+        const char* first_name = g_tcim_api.tcim_module_get_input_name(decode_model_, 0);
+        if (first_name) {
+            auto it = decode_input_map_.find(first_name);
+            if (it != decode_input_map_.end() && it->second) {
+                tcim_tensor_info_t info = g_tcim_api.tcim_tensor_get_info(it->second);
+                if (info) {
+                    n_decode_batch_ = g_tcim_api.tcim_tensor_info_get_shape_dim(info, 0);
+                    g_tcim_api.tcim_tensor_info_destroy(info);
+                }
+            }
+        }
+    }
+
+    // 填充decode 的output
+    int output_num_decode = g_tcim_api.tcim_module_get_output_num(decode_model_);
+    for (int idx = 0; idx < output_num_decode; idx++) {
+        const char* output_name_c = g_tcim_api.tcim_module_get_output_name(decode_model_, idx);
+        if (!output_name_c) continue;
+        std::string output_name(output_name_c);
+        tcim_tensor_info_t output_info = g_tcim_api.tcim_module_get_output_info(decode_model_, output_name_c);
+        if (!output_info) continue;
+        tcim_tensor_info_t output_info_contiguous = g_tcim_api.tcim_tensor_info_as_contiguous(output_info);
+        g_tcim_api.tcim_tensor_info_destroy(output_info);
+        tcim_tensor_info_t output_info_float = g_tcim_api.tcim_tensor_info_as_type(output_info_contiguous, TCIM_FLOAT32);
+        g_tcim_api.tcim_tensor_info_destroy(output_info_contiguous);
+        tcim_tensor_t output_tensor = g_tcim_api.tcim_tensor_create_host(output_info_float, 0, nullptr);
+        g_tcim_api.tcim_tensor_info_destroy(output_info_float);
+        if (output_tensor) {
+            decode_output_map_.insert(std::pair<std::string, tcim_tensor_t>(output_name, output_tensor));
+            decode_output_names_.push_back(output_name);
+        }
+    }
+    if (seq_max > 4) {
+        LLAMA_LOG_ERROR("%s: seq_max > 4 not supported, set seq_max to 4\n",
+                        __func__);
+        seq_max = 4;
+    }
+    int size = (seq_max + n_prefill_batch_ - 1) / n_prefill_batch_;
+    size = std::max(size, n_decode_batch_);
+    for (int i = 0; i < size; i++) {
+        kv_cache_item item;
+        item.seq_id = i;
+        for (int idx = 0; idx < n_blocks_; idx++) {
+            std::string k_cache_name = "model_layers_" + std::to_string(idx) +
+                                       "_self_attn_kcache_input";
+            std::string v_cache_name = "model_layers_" + std::to_string(idx) +
+                                       "_self_attn_vcache_input";
+
+            item.names.push_back(k_cache_name);
+            item.names.push_back(v_cache_name);
+
+            if (n_decode_batch_ > 1) {
+                k_cache_name = k_cache_name + "_batch" +
+                               std::to_string(i);
+                v_cache_name = v_cache_name + "_batch" +
+                               std::to_string(i);
+            }
+            tcim_tensor_t kcache = g_tcim_api.tcim_module_get_dev_input(decode_model_, k_cache_name.c_str());
+            tcim_tensor_t vcache = g_tcim_api.tcim_module_get_dev_input(decode_model_, v_cache_name.c_str());
+            if (n_decode_batch_ > 1 || seq_max == 1) {
+                item.tensors.push_back(kcache);
+                item.tensors.push_back(vcache);
+            } else {
+                tcim_tensor_t kcache_clone = g_tcim_api.tcim_tensor_clone(kcache);
+                tcim_tensor_t vcache_clone = g_tcim_api.tcim_tensor_clone(vcache);
+                item.tensors.push_back(kcache_clone);
+                item.tensors.push_back(vcache_clone);
+                need_set_kv_cache_ = 1;
+            }
+            if (kcache) {
+                tcim_tensor_info_t kinfo = g_tcim_api.tcim_tensor_get_info(kcache);
+                if (kinfo) {
+                    size_t shape_num = g_tcim_api.tcim_tensor_info_get_shape_num(kinfo);
+                    if (shape_num >= 2) {
+                        int64_t dim_last = g_tcim_api.tcim_tensor_info_get_shape_dim(kinfo, shape_num - 1);
+                        int64_t dim_prev = g_tcim_api.tcim_tensor_info_get_shape_dim(kinfo, shape_num - 2);
+                        context_length_ = std::max(dim_last, dim_prev);
+                    }
+                    g_tcim_api.tcim_tensor_info_destroy(kinfo);
+                }
+            }
+        }
+        kv_cache_[i] = item;
+    }
+    // lora_mask from index 3.
+    for (size_t index = 3; index < input_names_.size(); ++index) {
+        auto prefill_it = prefill_input_map_.find(input_names_[index]);
+        auto decode_it = decode_input_map_.find(input_names_[index]);
+        if (prefill_it != prefill_input_map_.end() && decode_it != decode_input_map_.end()) {
+            tcim_tensor_t lora_mask = prefill_it->second;
+            SetInputData<uint16_t>(lora_mask, 1, 0);
+            g_tcim_api.tcim_module_set_input(prefill_model_, input_names_[index].c_str(), lora_mask);
+            tcim_tensor_t decode_lora_mask = decode_it->second;
+            SetInputData<uint16_t>(decode_lora_mask, 1, 0);
+            g_tcim_api.tcim_module_set_input(decode_model_, input_names_[index].c_str(), decode_lora_mask);
+
+            tcim_tensor_info_t lora_info = g_tcim_api.tcim_tensor_get_info(lora_mask);
+            if (lora_info) {
+                tcim_tensor_info_t lora_info_contiguous = g_tcim_api.tcim_tensor_info_as_contiguous(lora_info);
+                g_tcim_api.tcim_tensor_info_destroy(lora_info);
+                tcim_tensor_info_t lora_info_float = g_tcim_api.tcim_tensor_info_as_type(lora_info_contiguous, TCIM_FLOAT32);
+                g_tcim_api.tcim_tensor_info_destroy(lora_info_contiguous);
+                lora_mask_float_ = g_tcim_api.tcim_tensor_create_host(lora_info_float, 0, nullptr);
+                g_tcim_api.tcim_tensor_info_destroy(lora_info_float);
+            }
+            LLAMA_LOG_INFO("set %d to %s\n", 0, input_names_[index].c_str());
+        }
+    }
+
+    // KV cache init.
+    LLAMA_LOG_INFO("%s: kvcache init finished\n", __func__);
+
+    // set current_length of decode input
+    const char* decode_input_name_2 = g_tcim_api.tcim_module_get_input_name(decode_model_, 2);
+    if (decode_input_name_2) {
+        auto it = decode_input_map_.find(decode_input_name_2);
+        if (it != decode_input_map_.end() && it->second) {
+            tcim_tensor_t decode_current_length = it->second;
+            tcim_data_type_t dtype = g_tcim_api.tcim_tensor_get_data_type(decode_current_length);
+            if (dtype == TCIM_INT16) {
+                SetInputData<int16_t>(decode_current_length, n_decode_batch_, 1);
+            } else if (dtype == TCIM_INT32) {
+                SetInputData<int32_t>(decode_current_length, n_decode_batch_, 1);
+            }
+            g_tcim_api.tcim_module_set_input(decode_model_, decode_input_name_2, decode_current_length);
+        }
+    }
+    LLAMA_LOG_INFO("%s: HMM graph init success\n", __func__);
+    LLAMA_LOG_INFO("prefill_length_ = %d\n context_length_ = %d\n "
+                   "n_blocks_ = %d\n n_embd_ = %ld\n n_prefill_batch_ = %d\n "
+                   "n_decode_batch_ = "
+                   "%d\n   kv_cache_size = %zu\n need_set_kv_cache_ = %d, "
+                   "prefill_input_num "
+                   "= %d， decode_input_num = %d\n",
+                   prefill_length_, context_length_, n_blocks_, n_embd_,
+                   n_prefill_batch_, n_decode_batch_, kv_cache_.size(),
+                   need_set_kv_cache_, input_num, input_num_decode);
+
+    // Cache output tensors for get_output_into reuse
+    if (!prefill_output_names_.empty()) {
+        prefill_output_raw_ = g_tcim_api.tcim_module_get_output(
+            prefill_model_, prefill_output_names_[0].c_str());
+    }
+    if (!decode_output_names_.empty()) {
+        decode_output_raw_ = g_tcim_api.tcim_module_get_output(
+            decode_model_, decode_output_names_[0].c_str());
+    }
+}
+
+int HouMoLLModel::Impl::houmo_prefill(std::vector<llama_token> &tokens, int seq_id,
+                                float *logits) {
+    LLAMA_LOG_DEBUG("%s seq_id = %d, tokens size is = %zu\n", "prefill stage",
+                   seq_id, tokens.size());
+    size_t input_echo_len = tokens.size();
+    if (input_echo_len == 0) {
+        return 0;
+    }
+    int16_t prefill_loop_round = ceil(static_cast<float>(input_echo_len) /
+                                      static_cast<float>(prefill_length_));
+    int32_t current_length = 0;
+    if ((input_echo_len + kv_offset_[seq_id]) >= (size_t)context_length_) {
+        LLAMA_LOG_WARN("tokens size is %zu exceeds context_length_(%d)\n",
+                       input_echo_len, context_length_);
+        return 1;
+    }
+    std::vector<llama_token> input_ids;
+    int32_t valid_length = kv_offset_[seq_id];
+    for (int round = 0; round < prefill_loop_round; round++) {
+        if (round == prefill_loop_round - 1) {
+            current_length = input_echo_len - round * prefill_length_;
+            auto first = tokens.begin() + round * prefill_length_;
+            auto last = tokens.begin() + input_echo_len;
+            std::vector<llama_token> round_tokens(first, last);
+            input_ids = round_tokens;
+        } else {
+            current_length = prefill_length_;
+            auto first = tokens.begin() + round * prefill_length_;
+            auto last = tokens.begin() + (round + 1) * prefill_length_;
+            std::vector<llama_token> round_tokens(first, last);
+            input_ids = round_tokens;
+        }
+        LLAMA_LOG_DEBUG("prefill round = %d, valid_length = %d, current_length = %d\n", round, valid_length, current_length);
+        const char* input_name_0 = g_tcim_api.tcim_module_get_input_name(prefill_model_, 0);
+        auto input_it = prefill_input_map_.find(input_name_0 ? input_name_0 : "");
+        if (input_it != prefill_input_map_.end() && input_it->second) {
+            tcim_tensor_t input_data = input_it->second;
+            memset(g_tcim_api.tcim_tensor_get_data(input_data), 0, g_tcim_api.tcim_tensor_get_mem_size(input_data));
+            embedding_layer_->get_embedding_batch(input_ids, g_tcim_api.tcim_tensor_get_data(input_data));
+            g_tcim_api.tcim_module_set_input(prefill_model_, input_name_0, input_data);
+        }
+
+        const char* input_name_1_c = g_tcim_api.tcim_module_get_input_name(prefill_model_, 1);
+        std::string input_name_1 = input_name_1_c ? std::string(input_name_1_c) : std::string();
+        const char* input_name_2_c = g_tcim_api.tcim_module_get_input_name(prefill_model_, 2);
+        std::string input_name_2 = input_name_2_c ? std::string(input_name_2_c) : std::string();
+        if (!input_name_1.empty() && !input_name_2.empty()) {
+            auto valid_it = prefill_input_map_.find(input_name_1);
+            auto current_it = prefill_input_map_.find(input_name_2);
+            if (valid_it != prefill_input_map_.end() && valid_it->second &&
+                current_it != prefill_input_map_.end() && current_it->second) {
+                tcim_tensor_t prefill_valid_length = valid_it->second;
+                tcim_tensor_t prefill_current_length = current_it->second;
+
+                tcim_data_type_t current_dtype = g_tcim_api.tcim_tensor_get_data_type(prefill_current_length);
+                if (current_dtype == TCIM_INT16) {
+                    SetInputData<int16_t>(prefill_valid_length, n_prefill_batch_, valid_length);
+                    SetInputData<int16_t>(prefill_current_length, n_prefill_batch_, current_length);
+                } else if (current_dtype == TCIM_INT32) {
+                    SetInputData<int32_t>(prefill_valid_length, n_prefill_batch_, valid_length);
+                    SetInputData<int32_t>(prefill_current_length, n_prefill_batch_, current_length);
+                }
+
+                LLAMA_LOG_DEBUG("%s = %d, %s = %d\n", input_name_1.c_str(), valid_length, input_name_2.c_str(), current_length);
+                g_tcim_api.tcim_module_set_input(prefill_model_, input_name_1.c_str(), prefill_valid_length);
+                g_tcim_api.tcim_module_set_input(prefill_model_, input_name_2.c_str(), prefill_current_length);
+            }
+        }
+
+        for (const auto& pair : lora_map) {
+            auto lora_it = prefill_input_map_.find(pair.first);
+            if (lora_it != prefill_input_map_.end() && lora_it->second && lora_mask_float_) {
+                tcim_tensor_t lora_mask = lora_it->second;
+                g_tcim_api.tcim_tensor_copy_from_host(lora_mask_float_, &pair.second.scale, g_tcim_api.tcim_tensor_get_mem_size(lora_mask_float_), 0);
+                g_tcim_api.tcim_tensor_cast_to(lora_mask_float_, lora_mask);
+                g_tcim_api.tcim_module_set_input(prefill_model_, pair.first.c_str(), lora_mask);
+                LLAMA_LOG_DEBUG("%s input set val = %f\n", pair.first.c_str(), pair.second.scale);
+            }
+        }
+
+        auto &item = kv_cache_[seq_id];
+        assert(item.seq_id == seq_id);
+        for (size_t idx = 0; idx < item.tensors.size(); idx++) {
+            std::string name = item.names[idx];
+            tcim_tensor_t tensor = item.tensors[idx];
+            g_tcim_api.tcim_module_set_input(prefill_model_, name.c_str(), tensor);
+        }
+        g_tcim_api.tcim_module_run(prefill_model_);
+        g_tcim_api.tcim_module_sync(prefill_model_);
+        valid_length += prefill_length_;
+    }
+
+    if (logits != nullptr && !prefill_output_names_.empty()) {
+        g_tcim_api.tcim_module_get_output_into(
+            prefill_model_, prefill_output_names_[0].c_str(), prefill_output_raw_);
+        // 转浮点
+        auto output_it = prefill_output_map_.find(prefill_output_names_[0]);
+        if (output_it != prefill_output_map_.end() && output_it->second) {
+            tcim_tensor_t prefill_output_float = output_it->second;
+            g_tcim_api.tcim_tensor_cast_to(prefill_output_raw_, prefill_output_float);
+            memcpy(logits,
+                   g_tcim_api.tcim_tensor_get_data(prefill_output_float),
+                   g_tcim_api.tcim_tensor_get_mem_size(prefill_output_float));
+        }
+    }
+    kv_offset_[seq_id] += input_echo_len;
+    return 0;
+}
+
+int HouMoLLModel::Impl::houmo_decode(std::vector<llama_token> &batches,
+                               std::vector<int> &seq_ids,
+                               std::vector<float *> logits) {
+    LLAMA_LOG_DEBUG("%s: seq_ids size = %zu, batches size = %zu\n", __func__,
+                    seq_ids.size(), batches.size());
+    if (seq_ids.size() > (size_t)n_decode_batch_) {
+        LLAMA_LOG_ERROR("%s: seq_ids.size() > n_decode_batch_ not supported\n", __func__);
+        return -1;
+    }
+
+    if (seq_ids.empty()) {
+        return 0;
+    }
+
+    for (size_t i = 0; i < seq_ids.size(); i++) {
+        int seq_id = seq_ids[i];
+        // Use kv_offset_ as the source of truth for valid length.
+        if (kv_offset_[seq_id] >= context_length_) {
+            LLAMA_LOG_WARN("seq_id %d valid length %d exceeds context_length_ %d\n",
+                           seq_id, kv_offset_[seq_id], context_length_);
+            return 1;
+        }
+    }
+    std::vector<llama_token> input_ids(n_decode_batch_, 0);
+    for (size_t i = 0; i < seq_ids.size(); i++) {
+        int batch_id = seq_ids[i];
+        // 单batch模式下所有序列共用batch 0
+        if (n_decode_batch_ == 1)
+            batch_id = 0;
+        input_ids[batch_id] = batches[i];
+    }
+
+    const char* input_name_0 = g_tcim_api.tcim_module_get_input_name(decode_model_, 0);
+    if (input_name_0) {
+        auto it = decode_input_map_.find(input_name_0);
+        if (it != decode_input_map_.end() && it->second) {
+            tcim_tensor_t input_data = it->second;
+            embedding_layer_->get_embedding_batch(input_ids, g_tcim_api.tcim_tensor_get_data(input_data));
+            g_tcim_api.tcim_module_set_input(decode_model_, input_name_0, input_data);
+        }
+    }
+
+    // set valid_length
+    std::vector<int32_t> valid_length_vec(n_decode_batch_, 1);
+    for (size_t k = 0; k < seq_ids.size(); k++) {
+        int batch_id = seq_ids[k];
+        // 单batch模式下所有序列共用batch 0
+        if (n_decode_batch_ == 1)
+            batch_id = 0;
+        // derive valid length from kv_offset_
+        valid_length_vec[batch_id] = kv_offset_[seq_ids[k]];
+    }
+
+    const char* input_name_1 = g_tcim_api.tcim_module_get_input_name(decode_model_, 1);
+    if (input_name_1) {
+        auto it = decode_input_map_.find(input_name_1);
+        if (it != decode_input_map_.end() && it->second) {
+            tcim_tensor_t decode_valid_length_tensor = it->second;
+            tcim_data_type_t dtype = g_tcim_api.tcim_tensor_get_data_type(decode_valid_length_tensor);
+            if (dtype == TCIM_INT16) {
+                SetInputData<int16_t>(decode_valid_length_tensor, valid_length_vec);
+            } else if (dtype == TCIM_INT32) {
+                SetInputData<int32_t>(decode_valid_length_tensor, valid_length_vec);
+            }
+            g_tcim_api.tcim_module_set_input(decode_model_, input_name_1, decode_valid_length_tensor);
+        }
+    }
+
+    if (need_set_kv_cache_ != 0) {
+        for (auto seq_id : seq_ids) {
+            auto &item = kv_cache_[seq_id];
+            for (size_t idx = 0; idx < item.tensors.size(); idx++) {
+                std::string name = item.names[idx];
+                if (n_decode_batch_ > 1)
+                    name = name + "_batch" +
+                           std::to_string(item.seq_id);
+                tcim_tensor_t tensor = item.tensors[idx];
+                g_tcim_api.tcim_module_set_input(decode_model_, name.c_str(), tensor);
+            }
+        }
+    }
+    for (const auto& pair : lora_map) {
+        auto it = decode_input_map_.find(pair.first);
+        if (it != decode_input_map_.end() && it->second && lora_mask_float_) {
+            tcim_tensor_t lora_mask = it->second;
+            g_tcim_api.tcim_tensor_copy_from_host(lora_mask_float_, &pair.second.scale, g_tcim_api.tcim_tensor_get_mem_size(lora_mask_float_), 0);
+            g_tcim_api.tcim_tensor_cast_to(lora_mask_float_, lora_mask);
+            g_tcim_api.tcim_module_set_input(decode_model_, pair.first.c_str(), lora_mask);
+        }
+    }
+    g_tcim_api.tcim_module_run(decode_model_);
+    g_tcim_api.tcim_module_sync(decode_model_);
+
+    if (!decode_output_names_.empty()) {
+        g_tcim_api.tcim_module_get_output_into(decode_model_, decode_output_names_[0].c_str(), decode_output_raw_);
+    }
+    // 转浮点
+    auto output_it = decode_output_map_.find(decode_output_names_[0]);
+    if (output_it != decode_output_map_.end() && output_it->second) {
+        tcim_tensor_t decode_output_float = output_it->second;
+        g_tcim_api.tcim_tensor_cast_to(decode_output_raw_, decode_output_float);
+        size_t output_mem_size = g_tcim_api.tcim_tensor_get_mem_size(decode_output_float);
+        auto n_vocab = output_mem_size / (n_decode_batch_ * sizeof(float));
+        for (size_t i = 0; i < seq_ids.size(); i++) {
+            auto batch_id = seq_ids[i];
+            // 单batch模式下所有序列共用batch 0
+            if (n_decode_batch_ == 1)
+                batch_id = 0;
+            float *logits_out = logits[i];
+            float *output_ptr = static_cast<float *>(g_tcim_api.tcim_tensor_get_data(decode_output_float)) +
+                                batch_id * n_vocab;
+            memcpy(logits_out, output_ptr, n_vocab * sizeof(float));
+            // kv_offset_ is the canonical counter of tokens in KV cache
+            kv_offset_[batch_id] ++;
+        }
+    }
+    return 0;
+}
+
+void HouMoLLModel::Impl::lora_init(std::string file_path, void *adapter) {
+    struct lora_item item;
+    item.adapter = adapter;
+    item.scale = 0.0;
+    lora_map[file_path] = item;
+    LLAMA_LOG_INFO("lora FILE_name IS %s\n", file_path.c_str());
+}
+
+void HouMoLLModel::Impl::lora_set_scale(void *adapter, float scale) {
+    for (auto iter = lora_map.begin(); iter != lora_map.end(); ++iter) {
+        if (iter->second.adapter == adapter) {
+            iter->second.scale = scale;
+        }
+    }
+}
+
+void HouMoLLModel::Impl::lora_clear() {
+    // scale set 0
+    for (auto iter = lora_map.begin(); iter != lora_map.end(); ++iter) {
+        iter->second.scale = 0;
+    }
+}
+
+void HouMoLLModel::Impl::seq_rm(int seq_id, int p0, int p1) {
+    (void)p1;
+    kv_offset_[seq_id] = std::min(kv_offset_[seq_id], p0);
+}
