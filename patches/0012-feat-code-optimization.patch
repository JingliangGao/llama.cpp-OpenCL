-            // O_0 = diag(ms0)*O_0 + diag(ms1)*O_1
-            {
-                s8x8_t ms0;
-                s8x8_t ms1;
-
-                simdgroup_load(ms0, ss + 2*C,         TS, 0, false);
-                simdgroup_load(ms1, ss + 2*C + sg*SH, TS, 0, false);
-
-                #pragma unroll(D8)
-                for (short i = 0; i < D8; ++i) {
-                    o8x8_t t;
-
-                    simdgroup_load    (t, so + i*8, D, 0, false);
