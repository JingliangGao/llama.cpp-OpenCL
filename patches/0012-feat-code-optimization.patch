-
-    if (!split_params.dry_run) {
-        // write all output splits
-        strategy.write();
-    }
-
-    // done, clean up
-    gguf_free(ctx_gguf);
-    f_input.close();
-
-    fprintf(stderr, "%s: %d gguf split written with a total of %d tensors.\n",
-            __func__, n_split, strategy.n_tensors);
-}
