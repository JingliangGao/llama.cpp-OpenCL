-                                simdgroup_barrier(mem_flags::mem_threadgroup);
-
-                                #pragma unroll(4)
-                                for (short k = 0; k < 4; ++k) {
-                                    v8x8_t mv;
-
-                                    simdgroup_load(mv, sv + 16*k + 0*8, 4*16, 0, false);
