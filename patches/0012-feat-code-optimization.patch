-// packed_B layout:
-//   quants {8, TILE_N, 16}  uint8
-//   qh     {8, TILE_N,  4}  uint8
-//   scales {8, TILE_N}      uint8
-//   mins   {8, TILE_N}      uint8
-//   d      {TILE_N}     ggml_half
-//   dmin   {TILE_N}     ggml_half
