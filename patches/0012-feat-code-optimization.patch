-def element_count_rounded_notation(count: int) -> str:
-    if count > 1e15 :
-        # Quadrillion
-        scaled_amount = count * 1e-15
-        scale_suffix = "Q"
-    elif count > 1e12 :
-        # Trillions
-        scaled_amount = count * 1e-12
-        scale_suffix = "T"
-    elif count > 1e9 :
-        # Billions
-        scaled_amount = count * 1e-9
-        scale_suffix = "B"
-    elif count > 1e6 :
-        # Millions
-        scaled_amount = count * 1e-6
-        scale_suffix = "M"
-    elif count > 1e3 :
-        # Thousands
-        scaled_amount = count * 1e-3
-        scale_suffix = "K"
-    else:
-        # Under Thousands
-        scaled_amount = count
-        scale_suffix = ""
-    return f"{'~' if count > 1e3 else ''}{round(scaled_amount)}{scale_suffix}"
