+struct llm_build_qwen3 : public llm_graph_context {
+    llm_build_qwen3(const llama_model & model, const llm_graph_params & params, ggml_cgraph * gf)
+        : llm_graph_context(params) {
+        const int64_t n_embd_head = hparams.n_embd_head_v;
+
+        GGML_ASSERT(n_embd_head == hparams.n_embd_head_k);
+        GGML_ASSERT(n_embd_head == hparams.n_rot);
+
+        ggml_tensor * cur;
+        ggml_tensor * inpL;
+
+        inpL = build_inp_embd(model.tok_embd);
+
+        ggml_tensor * inp_pos = build_inp_pos();
+        auto * inp_attn = build_attn_inp_kv_unified();
+
+        for (int il = 0; il < n_layer; ++il) {
+            ggml_tensor * inpSA = inpL;
+
+            cur = build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
+            cb(cur, "attn_norm", il);
+
+            {
+                ggml_tensor * Qcur = build_lora_mm(model.layers[il].wq, cur);
+                cb(Qcur, "Qcur", il);
+
+                ggml_tensor * Kcur = build_lora_mm(model.layers[il].wk, cur);
+                cb(Kcur, "Kcur", il);
+
+                ggml_tensor * Vcur = build_lora_mm(model.layers[il].wv, cur);
+                cb(Vcur, "Vcur", il);
+
+                Qcur = ggml_reshape_3d(ctx0, Qcur, n_embd_head, n_head,    n_tokens);
+                Kcur = ggml_reshape_3d(ctx0, Kcur, n_embd_head, n_head_kv, n_tokens);
+                Vcur = ggml_reshape_3d(ctx0, Vcur, n_embd_head, n_head_kv, n_tokens);
+
+                // Qwen3 adds per-head Q/K normalization before RoPE
+                Qcur = build_norm(Qcur, model.layers[il].attn_q_norm, NULL, LLM_NORM_RMS, il);
+                cb(Qcur, "Qcur_normed", il);
+
+                Qcur = ggml_rope_ext(ctx0, Qcur, inp_pos, nullptr,
+                        n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                        ext_factor, attn_factor, beta_fast, beta_slow);
+
+                Kcur = build_norm(Kcur, model.layers[il].attn_k_norm, NULL, LLM_NORM_RMS, il);
+                cb(Kcur, "Kcur_normed", il);
+
+                Kcur = ggml_rope_ext(ctx0, Kcur, inp_pos, nullptr,
+                        n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                        ext_factor, attn_factor, beta_fast, beta_slow);
+
+                cb(Qcur, "Qcur", il);
+                cb(Kcur, "Kcur", il);
+                cb(Vcur, "Vcur", il);
+
+                cur = build_attn(inp_attn, gf,
+                        model.layers[il].wo, model.layers[il].bo,
+                        Qcur, Kcur, Vcur, nullptr, 1.0f / sqrtf(float(n_embd_head)), il);
+            }
+
+            if (il == n_layer - 1) {
+                ggml_tensor * inp_out_ids = build_inp_out_ids();
+                cur   = ggml_get_rows(ctx0,   cur, inp_out_ids);
+                inpSA = ggml_get_rows(ctx0, inpSA, inp_out_ids);
+            }
+
+            ggml_tensor * ffn_inp = ggml_add(ctx0, cur, inpSA);
+            cb(ffn_inp, "ffn_inp", il);
+
+            cur = build_norm(ffn_inp, model.layers[il].ffn_norm, NULL, LLM_NORM_RMS, il);
+            cb(cur, "ffn_norm", il);
+
+            cur = build_ffn(cur,
+                    model.layers[il].ffn_up,   NULL, NULL,
+                    model.layers[il].ffn_gate, NULL, NULL,
+                    model.layers[il].ffn_down, NULL, NULL,
+                    NULL,
+                    LLM_FFN_SILU, LLM_FFN_PAR, il);
+            cb(cur, "ffn_out", il);
+
+            cur = ggml_add(ctx0, cur, ffn_inp);
+            cur = build_cvec(cur, il);
+            cb(cur, "l_out", il);
+
+            inpL = cur;
+        }
+
+        cur = inpL;
+        cur = build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
+        cb(cur, "result_norm", -1);
+        res->t_embd = cur;
+
+        cur = build_lora_mm(model.output, cur);
+        cb(cur, "result_output", -1);
+        res->t_logits = cur;
+
+        ggml_build_forward_expand(gf, cur);
+    }
+};
+
+std::unique_ptr<llm_arch_model> llm_arch_model::create(llm_arch arch) {
+    static const std::unordered_map<llm_arch,
+        std::function<std::unique_ptr<llm_arch_model>()>> REGISTRY = {
+        {LLM_ARCH_QWEN2, [] { return std::make_unique<llm_arch_model_qwen2>(); }},
+        {LLM_ARCH_QWEN3, [] { return std::make_unique<llm_arch_model_qwen3>(); }},
+    };
+
+    const auto it = REGISTRY.find(arch);
+    if (it == REGISTRY.end()) {
+        throw std::runtime_error("unsupported model architecture: " +
+                                  std::string(llm_arch_name(arch)));
+    }
+    return it->second();
+}
+
+struct qwen2_size_entry {
+    uint32_t n_layer;
+    int64_t  n_embd;   // 0 = any
+    int32_t  n_head;   // 0 = any
+    llm_type type;
+};
+
+static const qwen2_size_entry QWEN2_SIZE_TABLE[] = {
+    {24, 1024, 0, LLM_TYPE_0_5B},
+    {24,    0, 0, LLM_TYPE_1B  },
+    {28, 1536, 0, LLM_TYPE_1_5B},
+    {28,    0, 0, LLM_TYPE_7B  },
+    {32,    0, 0, LLM_TYPE_7B  },
+    {36,    0, 0, LLM_TYPE_3B  },
+    {40,    0,20, LLM_TYPE_4B  },
+    {40,    0, 0, LLM_TYPE_13B },
+    {48,    0, 0, LLM_TYPE_14B },
+    {64,    0, 0, LLM_TYPE_32B },
+    {80,    0, 0, LLM_TYPE_70B },
+};
+
+void llm_arch_model_qwen2::init_hparams(llama_model & model, llama_model_loader & ml) {
+    ml.get_key(LLM_KV_ATTENTION_LAYERNORM_RMS_EPS, model.hparams.f_norm_rms_eps);
+
+    const auto & hp = model.hparams;
+    model.type = LLM_TYPE_UNKNOWN;
+    for (const auto & e : QWEN2_SIZE_TABLE) {
+        if (hp.n_layer == e.n_layer &&
+            (e.n_embd == 0 || hp.n_embd       == e.n_embd) &&
+            (e.n_head == 0 || hp.n_head()      == (uint32_t)e.n_head)) {
+            model.type = e.type;
+            break;
+        }
+    }
+}
+
+void llm_arch_model_qwen2::create_tensors(llama_model & model, const create_tensor_fn & create) {
+    const auto & hp = model.hparams;
+
+    const int64_t n_embd       = hp.n_embd;
+    const int64_t n_embd_gqa   = hp.n_embd_v_gqa();
+    const int64_t n_ff         = hp.n_ff();
+    const int64_t n_vocab      = model.vocab.n_tokens();
+    const int     n_layer      = hp.n_layer;
+
+    const int TENSOR_NOT_REQUIRED = llama_model_loader::TENSOR_NOT_REQUIRED;
+    const int TENSOR_DUPLICATED   = llama_model_loader::TENSOR_DUPLICATED;
+
+    const auto tn = LLM_TN(model.arch);
+
+    model.tok_embd    = create(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"),   {n_embd, n_vocab}, 0);
+    model.output_norm = create(tn(LLM_TENSOR_OUTPUT_NORM, "weight"),   {n_embd},          0);
+    model.output      = create(tn(LLM_TENSOR_OUTPUT,      "weight"),   {n_embd, n_vocab}, TENSOR_NOT_REQUIRED);
+    if (model.output == nullptr) {
+        model.output  = create(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"),   {n_embd, n_vocab}, TENSOR_DUPLICATED);
+    }
+
+    for (int i = 0; i < n_layer; ++i) {
+        auto & layer = model.layers[i];
+
+        layer.attn_norm = create(tn(LLM_TENSOR_ATTN_NORM, "weight", i), {n_embd},          0);
+        layer.wq        = create(tn(LLM_TENSOR_ATTN_Q,    "weight", i), {n_embd, n_embd},   0);
+        layer.wk        = create(tn(LLM_TENSOR_ATTN_K,    "weight", i), {n_embd, n_embd_gqa}, 0);
+        layer.wv        = create(tn(LLM_TENSOR_ATTN_V,    "weight", i), {n_embd, n_embd_gqa}, 0);
+        layer.wo        = create(tn(LLM_TENSOR_ATTN_OUT,  "weight", i), {n_embd, n_embd},   0);
+
+        layer.bq        = create(tn(LLM_TENSOR_ATTN_Q,    "bias",   i), {n_embd},          0);
+        layer.bk        = create(tn(LLM_TENSOR_ATTN_K,    "bias",   i), {n_embd_gqa},      0);
+        layer.bv        = create(tn(LLM_TENSOR_ATTN_V,    "bias",   i), {n_embd_gqa},      0);
+
+        layer.ffn_norm  = create(tn(LLM_TENSOR_FFN_NORM,  "weight", i), {n_embd},          0);
+        layer.ffn_gate  = create(tn(LLM_TENSOR_FFN_GATE,  "weight", i), {n_embd, n_ff},    0);
+        layer.ffn_down  = create(tn(LLM_TENSOR_FFN_DOWN,  "weight", i), {n_ff,   n_embd},  0);
+        layer.ffn_up    = create(tn(LLM_TENSOR_FFN_UP,    "weight", i), {n_embd, n_ff},    0);
+    }
+}
+
+llama_rope_type llm_arch_model_qwen2::rope_type() const {
+    return LLAMA_ROPE_TYPE_NEOX;
+}
+
+llm_graph_result_ptr llm_arch_model_qwen2::build_graph(const llama_model & model,
+                                                         const llm_graph_params & params,
+                                                         ggml_cgraph * gf,
+                                                         llm_graph_type /*type*/) const {
+    auto llm = std::make_unique<llm_build_qwen2>(model, params, gf);
+    llm->build_pooling(gf, model.cls, model.cls_b, model.cls_out, model.cls_out_b);
+    return std::move(llm->res);
+}
+
+void llm_arch_model_qwen3::init_hparams(llama_model & model, llama_model_loader & ml) {
+    ml.get_key(LLM_KV_ATTENTION_LAYERNORM_RMS_EPS, model.hparams.f_norm_rms_eps);
+    model.type = LLM_TYPE_UNKNOWN;
+}
+
+void llm_arch_model_qwen3::create_tensors(llama_model & model, const create_tensor_fn & create) {
+    const auto & hp = model.hparams;
+
+    const int64_t n_embd        = hp.n_embd;
+    const int64_t n_head        = hp.n_head();
+    const int64_t n_embd_gqa    = hp.n_embd_v_gqa();
+    const int64_t n_embd_head_k = hp.n_embd_head_k;
+    const int64_t n_ff          = hp.n_ff();
+    const int64_t n_vocab       = model.vocab.n_tokens();
+    const int     n_layer       = hp.n_layer;
+
+    const int TENSOR_NOT_REQUIRED = llama_model_loader::TENSOR_NOT_REQUIRED;
+    const int TENSOR_DUPLICATED   = llama_model_loader::TENSOR_DUPLICATED;
+
+    const auto tn = LLM_TN(model.arch);
+
+    model.tok_embd    = create(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"),   {n_embd, n_vocab}, 0);
+    model.output_norm = create(tn(LLM_TENSOR_OUTPUT_NORM, "weight"),   {n_embd},          0);
+    model.output      = create(tn(LLM_TENSOR_OUTPUT,      "weight"),   {n_embd, n_vocab}, TENSOR_NOT_REQUIRED);
+    if (model.output == nullptr) {
+        model.output  = create(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"),   {n_embd, n_vocab}, TENSOR_DUPLICATED);
+    }
+
+    for (int i = 0; i < n_layer; ++i) {
+        auto & layer = model.layers[i];
+
+        layer.attn_norm   = create(tn(LLM_TENSOR_ATTN_NORM,   "weight", i), {n_embd}, 0);
+
+        layer.wq          = create(tn(LLM_TENSOR_ATTN_Q,      "weight", i), {n_embd, n_embd_head_k * n_head}, 0);
+        layer.wk          = create(tn(LLM_TENSOR_ATTN_K,      "weight", i), {n_embd, n_embd_gqa},             0);
+        layer.wv          = create(tn(LLM_TENSOR_ATTN_V,      "weight", i), {n_embd, n_embd_gqa},             0);
+        layer.wo          = create(tn(LLM_TENSOR_ATTN_OUT,    "weight", i), {n_embd_head_k * n_head, n_embd},  0);
+
+        layer.attn_k_norm = create(tn(LLM_TENSOR_ATTN_K_NORM, "weight", i), {n_embd_head_k}, 0);
+        layer.attn_q_norm = create(tn(LLM_TENSOR_ATTN_Q_NORM, "weight", i), {n_embd_head_k}, 0);
+
+        layer.ffn_norm    = create(tn(LLM_TENSOR_FFN_NORM,    "weight", i), {n_embd},          0);
+        layer.ffn_gate    = create(tn(LLM_TENSOR_FFN_GATE,    "weight", i), {n_embd, n_ff},    0);
+        layer.ffn_down    = create(tn(LLM_TENSOR_FFN_DOWN,    "weight", i), {n_ff,   n_embd},  0);
+        layer.ffn_up      = create(tn(LLM_TENSOR_FFN_UP,      "weight", i), {n_embd, n_ff},    0);
+    }
+}
+
+llama_rope_type llm_arch_model_qwen3::rope_type() const {
