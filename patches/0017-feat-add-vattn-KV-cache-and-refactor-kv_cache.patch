diff --git a/ggml/include/ggml-vmem.h b/ggml/include/ggml-vmem.h
new file mode 100644
index 0000000..02a9c55
--- /dev/null
+++ b/ggml/include/ggml-vmem.h
@@ -0,0 +1,155 @@
+#pragma once
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// ---- 后端选择 ----
+enum ggml_vmem_backend_type {
+    GGML_VMEM_BACKEND_NONE = 0,
+    //GGML_VMEM_BACKEND_CUDA = 1,
+    // 预留：GGML_VMEM_BACKEND_XPU、GGML_VMEM_BACKEND_HIP 等
+};
+
+// ---- 配置参数 ----
+struct ggml_vmem_config {
+    int    num_layers;
+    int    num_kv_heads;
+    int    head_size;
+    size_t max_context_length;
+    size_t bytes_per_elem;
+    int    device;
+};
+
+// ---- 统计信息 ----
+struct ggml_vmem_stats {
+    size_t virtual_size;
+    size_t mapped_pages;
+    size_t free_pool_pages;
+    size_t tokens_per_page;
+    size_t page_size_bytes;
+};
+
+// 不透明分配器句柄（由分发层管理，后端无感知）
+typedef struct ggml_vmem_allocator * ggml_vmem_allocator_t;
+
+// ============================================================================
+// 公共 API（与后端无关）
+// ============================================================================
+
+// 创建分配器（按 backend 类型查找已注册实现）
+GGML_API ggml_vmem_allocator_t ggml_vmem_allocator_init(
+    enum ggml_vmem_backend_type backend,
+    const struct ggml_vmem_config * config);
+
+GGML_API void ggml_vmem_allocator_free(ggml_vmem_allocator_t alloc);
+
+GGML_API size_t ggml_vmem_reserve_pages(ggml_vmem_allocator_t alloc, size_t free_memory);
+
+// 查询所选后端设备的可用/总显存（用于上层决定 reserve 配额）
+GGML_API void ggml_vmem_get_device_memory(
+    ggml_vmem_allocator_t alloc,
+    size_t * free_bytes,
+    size_t * total_bytes);
+
+GGML_API bool ggml_vmem_grow_sync(ggml_vmem_allocator_t alloc, size_t num_tokens);
+
+GGML_API void ggml_vmem_reclaim(ggml_vmem_allocator_t alloc, size_t num_tokens_to_keep);
+
+// 释放所有映射的物理页
+GGML_API void ggml_vmem_release_all_pages(ggml_vmem_allocator_t alloc);
+
+GGML_API void ggml_vmem_set_async(ggml_vmem_allocator_t alloc, bool enabled);
+GGML_API void ggml_vmem_step_async(ggml_vmem_allocator_t alloc, size_t total_tokens_needed);
+
+// 获取每层 K/V 虚拟地址基址
+GGML_API void * ggml_vmem_get_k_ptr(ggml_vmem_allocator_t alloc, int layer_idx);
+GGML_API void * ggml_vmem_get_v_ptr(ggml_vmem_allocator_t alloc, int layer_idx);
+
+// 包装虚拟地址区间为 ggml backend buffer（由对应后端实现）
+GGML_API ggml_backend_buffer_t ggml_vmem_buffer_from_ptr(
+    ggml_vmem_allocator_t alloc,
+    void * ptr,
+    size_t size);
+
+// Defrag：通过后端原生 D2D 拷贝在 cell 粒度移动数据
+GGML_API void ggml_vmem_defrag_move(
+    ggml_vmem_allocator_t alloc,
+    const uint32_t * ids,
+    uint32_t n_ids,
+    bool v_trans,
+    uint32_t kv_size);
+
+// 统计信息
+GGML_API struct ggml_vmem_stats ggml_vmem_get_stats(ggml_vmem_allocator_t alloc);
+GGML_API size_t ggml_vmem_get_virtual_size(ggml_vmem_allocator_t alloc);
+GGML_API size_t ggml_vmem_get_num_mapped_pages(ggml_vmem_allocator_t alloc);
+GGML_API size_t ggml_vmem_get_num_free_pages(ggml_vmem_allocator_t alloc);
+GGML_API size_t ggml_vmem_get_tokens_per_page(ggml_vmem_allocator_t alloc);
+GGML_API size_t ggml_vmem_get_page_size_bytes(ggml_vmem_allocator_t alloc);
+
+GGML_API enum ggml_vmem_backend_type ggml_vmem_get_backend(ggml_vmem_allocator_t alloc);
+
+// ============================================================================
+// 后端注册接口
+// ----------------------------------------------------------------------------
+// 各硬件后端实现下列 vtable，并通过 ggml_vmem_register_backend() 注册到分发层。
+// impl 字段是后端私有结构体的不透明指针，由 init() 创建、free() 释放。
+// ============================================================================
+
+struct ggml_vmem_backend_iface {
+    // 生命周期
+    void * (*init)(const struct ggml_vmem_config * config);
+    void   (*free)(void * impl);
+
+    // 内存管理
+    size_t (*reserve_pages)    (void * impl, size_t free_memory);
+    bool   (*grow_sync)        (void * impl, size_t num_tokens);
+    void   (*reclaim)          (void * impl, size_t num_tokens_to_keep);
+    void   (*release_all_pages)(void * impl);
+
+    // 设备内存查询
+    void (*get_device_memory)(void * impl, size_t * free_bytes, size_t * total_bytes);
+
+    // 异步
+    void   (*set_async) (void * impl, bool enabled);
+    void   (*step_async)(void * impl, size_t total_tokens_needed);
+
+    // 查询
+    void * (*get_k_ptr)(void * impl, int layer_idx);
+    void * (*get_v_ptr)(void * impl, int layer_idx);
+
+    size_t (*get_virtual_size)    (void * impl);
+    size_t (*get_num_mapped_pages)(void * impl);
+    size_t (*get_num_free_pages)  (void * impl);
+    size_t (*get_tokens_per_page) (void * impl);
+    size_t (*get_page_size_bytes) (void * impl);
+
+    // Buffer 包装
+    ggml_backend_buffer_t (*buffer_from_ptr)(void * impl, void * ptr, size_t size);
+
+    // Defrag
+    void (*defrag_move)(void * impl, const uint32_t * ids, uint32_t n_ids, bool v_trans, uint32_t kv_size);
+};
+
+// 注册后端实现（多次注册同 backend 时后注册者覆盖前者）
+GGML_API void ggml_vmem_register_backend(
+    enum ggml_vmem_backend_type backend,
+    const struct ggml_vmem_backend_iface * iface);
+
+// 查询是否已注册
+GGML_API bool ggml_vmem_backend_available(ggml_vmem_backend_type backend);
+
+// 自动探测第一个可用的已注册后端（返回 NONE 表示无可用后端）
+GGML_API ggml_vmem_backend_type ggml_vmem_detect_available_backend(void);
+
+#ifdef __cplusplus
+}
+#endif
