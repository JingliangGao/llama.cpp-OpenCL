-def match_regex(regex: str, text: str) -> bool:
-    return (
-        re.compile(
-            regex, flags=RegexFlag.IGNORECASE | RegexFlag.MULTILINE | RegexFlag.DOTALL
-        ).search(text)
-        is not None
-    )
