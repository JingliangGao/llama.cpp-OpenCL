+#pragma once
+
+#include "llama-arch.h"
+#include "llama-graph.h"
+
+#include <functional>
+#include <memory>
+
+struct llama_model;
+struct llama_model_loader;
+struct ggml_cgraph;
+struct ggml_tensor;
+
+using create_tensor_fn = std::function<ggml_tensor *(const LLM_TN_IMPL &,
+                                                      const std::initializer_list<int64_t> &,
+                                                      int)>;
+
+
+class llm_arch_model {
+public:
